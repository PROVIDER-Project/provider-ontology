@prefix sc:       <http://projekt-provider.de/ontology/supply-chain#> .
@prefix provider: <http://projekt-provider.de/ontology/> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .

<http://projekt-provider.de/ontology/supply-chain>
    a owl:Ontology ;
    owl:imports <http://projekt-provider.de/ontology/> ;
    rdfs:label "PROVIDER Supply Chain Operations Ontology"@en ;
    rdfs:comment """
        Supply-chain operations module for representing organizations,
        facilities, products, inventory, orders, shipments, documents,
        operational qualities, and supply-chain processes. Upper concepts are
        aligned to the PROVIDER core ontology instead of duplicated as a
        separate top-level model.
    """@en ;
    dcterms:modified "2026-06-04"^^xsd:date ;
    owl:versionInfo "0.2.0" .


#################################################################
# Core aliases and module-specific continuants
#################################################################

sc:SupplyChainEntity
    a owl:Class ;
    rdfs:label "supply chain entity"@en ;
    rdfs:comment "A material, organizational, informational, operational, or locational entity relevant to a supply chain."@en .

sc:Organization
    a owl:Class ;
    owl:equivalentClass provider:Organization ;
    rdfs:subClassOf sc:SupplyChainEntity ;
    rdfs:label "organization"@en ;
    rdfs:comment "Alias for provider:Organization in the supply-chain module namespace."@en .

sc:Facility
    a owl:Class ;
    owl:equivalentClass provider:Facility ;
    rdfs:subClassOf sc:SupplyChainEntity ;
    rdfs:label "facility"@en ;
    rdfs:comment "Alias for provider:Facility in the supply-chain module namespace."@en .

sc:Product
    a owl:Class ;
    owl:equivalentClass provider:Product ;
    rdfs:subClassOf sc:SupplyChainEntity ;
    rdfs:label "product"@en ;
    rdfs:comment "Alias for provider:Product in the supply-chain module namespace."@en .

sc:Location
    a owl:Class ;
    rdfs:subClassOf provider:Region, sc:SupplyChainEntity ;
    rdfs:label "location"@en ;
    rdfs:comment "A geographic or operational place relevant to supply-chain activity."@en .

sc:Warehouse
    a owl:Class ;
    rdfs:subClassOf sc:Facility, provider:StorageFacility ;
    rdfs:label "warehouse"@en .

sc:ManufacturingPlant
    a owl:Class ;
    rdfs:subClassOf sc:Facility, provider:ProcessingFacility ;
    rdfs:label "manufacturing plant"@en .

sc:DistributionCenter
    a owl:Class ;
    rdfs:subClassOf sc:Facility, provider:TransferFacility ;
    rdfs:label "distribution center"@en .

sc:MaterialItem
    a owl:Class ;
    rdfs:subClassOf sc:SupplyChainEntity ;
    rdfs:label "material item"@en ;
    rdfs:comment "A physical item or batch instance in the supply chain."@en .

sc:Batch
    a owl:Class ;
    rdfs:subClassOf sc:MaterialItem ;
    rdfs:label "batch"@en ;
    rdfs:comment "A collection of material items produced, received, stored, or shipped together."@en .

sc:Inventory
    a owl:Class ;
    rdfs:subClassOf sc:SupplyChainEntity ;
    rdfs:label "inventory"@en ;
    rdfs:comment "A stock of material items held at a facility or location."@en .


#################################################################
# Roles
#################################################################

sc:SupplyChainRole
    a owl:Class ;
    owl:equivalentClass provider:SupplyChainRole ;
    rdfs:label "supply chain role"@en ;
    rdfs:comment "Alias for provider:SupplyChainRole in the supply-chain module namespace."@en .

sc:SupplierRole
    a owl:Class ;
    rdfs:subClassOf sc:SupplyChainRole, provider:SupplierRole ;
    rdfs:label "supplier role"@en .

sc:ProducerRole
    a owl:Class ;
    rdfs:subClassOf sc:SupplierRole, provider:ProducerRole ;
    rdfs:label "producer role"@en .

sc:FarmerRole
    a owl:Class ;
    rdfs:subClassOf sc:ProducerRole, provider:FarmerRole ;
    rdfs:label "farmer role"@en .

sc:ManufacturerRole
    a owl:Class ;
    rdfs:subClassOf sc:SupplyChainRole, provider:ManufacturerRole ;
    rdfs:label "manufacturer role"@en .

sc:ProcessorRole
    a owl:Class ;
    rdfs:subClassOf sc:ManufacturerRole, provider:ProcessorRole ;
    rdfs:label "processor role"@en .

sc:CarrierRole
    a owl:Class ;
    rdfs:subClassOf sc:SupplyChainRole, provider:CarrierRole ;
    rdfs:label "carrier role"@en .

sc:CustomerRole
    a owl:Class ;
    rdfs:subClassOf sc:SupplyChainRole, provider:CustomerRole ;
    rdfs:label "customer role"@en .

sc:TraderRole
    a owl:Class ;
    rdfs:subClassOf sc:SupplyChainRole, provider:TraderRole ;
    rdfs:label "trader role"@en .

sc:WarehouseOperatorRole
    a owl:Class ;
    rdfs:subClassOf sc:SupplyChainRole, provider:WarehouseOperatorRole ;
    rdfs:label "warehouse operator role"@en .

sc:RegulatorRole
    a owl:Class ;
    rdfs:subClassOf sc:SupplyChainRole, provider:RegulatorRole ;
    rdfs:label "regulator role"@en .


#################################################################
# Information entities: orders, documents, identifiers
#################################################################

sc:SupplyChainInformationEntity
    a owl:Class ;
    rdfs:subClassOf sc:SupplyChainEntity ;
    rdfs:label "supply chain information entity"@en ;
    rdfs:comment "An information artifact used in supply-chain coordination or documentation."@en .

sc:Identifier
    a owl:Class ;
    rdfs:subClassOf sc:SupplyChainInformationEntity ;
    rdfs:label "identifier"@en .

sc:SKU
    a owl:Class ;
    rdfs:subClassOf sc:Identifier ;
    rdfs:label "SKU"@en ;
    rdfs:comment "A stock keeping unit identifier."@en .

sc:Order
    a owl:Class ;
    rdfs:subClassOf sc:SupplyChainInformationEntity ;
    rdfs:label "order"@en ;
    rdfs:comment "An information entity representing a request for goods or services."@en .

sc:PurchaseOrder
    a owl:Class ;
    rdfs:subClassOf sc:Order ;
    rdfs:label "purchase order"@en .

sc:SalesOrder
    a owl:Class ;
    rdfs:subClassOf sc:Order ;
    rdfs:label "sales order"@en .

sc:ShipmentDocument
    a owl:Class ;
    rdfs:subClassOf sc:SupplyChainInformationEntity ;
    rdfs:label "shipment document"@en .

sc:Invoice
    a owl:Class ;
    rdfs:subClassOf sc:SupplyChainInformationEntity ;
    rdfs:label "invoice"@en .


#################################################################
# Processes
#################################################################

sc:SupplyChainProcess
    a owl:Class ;
    rdfs:subClassOf provider:Process ;
    rdfs:label "supply chain process"@en ;
    rdfs:comment "A process in which supply-chain entities participate."@en .

sc:ProcurementProcess
    a owl:Class ;
    rdfs:subClassOf sc:SupplyChainProcess ;
    rdfs:label "procurement process"@en .

sc:ManufacturingProcess
    a owl:Class ;
    rdfs:subClassOf sc:SupplyChainProcess ;
    rdfs:label "manufacturing process"@en .

sc:TransportationProcess
    a owl:Class ;
    rdfs:subClassOf sc:SupplyChainProcess, provider:Flow ;
    rdfs:label "transportation process"@en .

sc:StorageProcess
    a owl:Class ;
    rdfs:subClassOf sc:SupplyChainProcess ;
    rdfs:label "storage process"@en .

sc:FulfillmentProcess
    a owl:Class ;
    rdfs:subClassOf sc:SupplyChainProcess ;
    rdfs:label "fulfillment process"@en .

sc:DeliveryProcess
    a owl:Class ;
    rdfs:subClassOf sc:TransportationProcess ;
    rdfs:label "delivery process"@en .

sc:InspectionProcess
    a owl:Class ;
    rdfs:subClassOf sc:SupplyChainProcess ;
    rdfs:label "inspection process"@en .


#################################################################
# Qualities and quantities
#################################################################

sc:SupplyChainQuality
    a owl:Class ;
    rdfs:label "supply chain quality"@en ;
    rdfs:comment "A dependent quality relevant to supply-chain management, such as quantity, weight, temperature, lead time, or status."@en .

sc:Quantity
    a owl:Class ;
    rdfs:subClassOf sc:SupplyChainQuality ;
    rdfs:label "quantity"@en .

sc:Weight
    a owl:Class ;
    rdfs:subClassOf sc:SupplyChainQuality ;
    rdfs:label "weight"@en .

sc:Temperature
    a owl:Class ;
    rdfs:subClassOf sc:SupplyChainQuality ;
    rdfs:label "temperature"@en .

sc:LeadTime
    a owl:Class ;
    rdfs:subClassOf sc:SupplyChainQuality ;
    rdfs:label "lead time"@en ;
    rdfs:comment "A temporal measure associated with a supply-chain process or commitment."@en .

sc:InventoryStatus
    a owl:Class ;
    rdfs:subClassOf sc:SupplyChainQuality ;
    rdfs:label "inventory status"@en .


#################################################################
# Object properties
#################################################################

sc:hasRole
    a owl:ObjectProperty ;
    rdfs:subPropertyOf provider:hasRole ;
    rdfs:label "has role"@en ;
    rdfs:range sc:SupplyChainRole .

sc:roleOf
    a owl:ObjectProperty ;
    rdfs:subPropertyOf provider:roleOf ;
    rdfs:label "role of"@en ;
    owl:inverseOf sc:hasRole .

sc:participatesIn
    a owl:ObjectProperty ;
    rdfs:subPropertyOf provider:participatesIn ;
    rdfs:label "participates in"@en ;
    rdfs:range sc:SupplyChainProcess .

sc:hasParticipant
    a owl:ObjectProperty ;
    rdfs:label "has participant"@en ;
    owl:inverseOf sc:participatesIn ;
    rdfs:domain sc:SupplyChainProcess .

sc:hasSupplier
    a owl:ObjectProperty ;
    rdfs:label "has supplier"@en ;
    rdfs:domain sc:Order ;
    rdfs:range sc:Organization .

sc:hasCustomer
    a owl:ObjectProperty ;
    rdfs:label "has customer"@en ;
    rdfs:domain sc:Order ;
    rdfs:range sc:Organization .

sc:ordersProduct
    a owl:ObjectProperty ;
    rdfs:subPropertyOf provider:handlesProduct ;
    rdfs:label "orders product"@en ;
    rdfs:domain sc:Order ;
    rdfs:range sc:Product .

sc:realizesOrder
    a owl:ObjectProperty ;
    rdfs:label "realizes order"@en ;
    rdfs:comment "Relates a fulfillment, procurement, or delivery process to the order it realizes."@en ;
    rdfs:domain sc:SupplyChainProcess ;
    rdfs:range sc:Order .

sc:hasOrigin
    a owl:ObjectProperty ;
    rdfs:subPropertyOf provider:originatesAt ;
    rdfs:label "has origin"@en ;
    rdfs:domain sc:TransportationProcess ;
    rdfs:range [ owl:unionOf ( sc:Location sc:Facility provider:Region ) ] .

sc:hasDestination
    a owl:ObjectProperty ;
    rdfs:subPropertyOf provider:terminatesAt ;
    rdfs:label "has destination"@en ;
    rdfs:domain sc:TransportationProcess ;
    rdfs:range [ owl:unionOf ( sc:Location sc:Facility provider:Region ) ] .

sc:storedAt
    a owl:ObjectProperty ;
    rdfs:subPropertyOf provider:storedAt ;
    rdfs:label "stored at"@en ;
    rdfs:domain sc:Inventory ;
    rdfs:range [ owl:unionOf ( sc:Facility sc:Location provider:Region ) ] .

sc:containsItem
    a owl:ObjectProperty ;
    rdfs:label "contains item"@en ;
    rdfs:domain sc:Inventory ;
    rdfs:range sc:MaterialItem .

sc:instanceOfProduct
    a owl:ObjectProperty ;
    rdfs:label "instance of product"@en ;
    rdfs:comment "Relates a physical material item or batch to the product type it instantiates."@en ;
    rdfs:domain sc:MaterialItem ;
    rdfs:range sc:Product .

sc:hasBatch
    a owl:ObjectProperty ;
    rdfs:label "has batch"@en ;
    rdfs:domain sc:Product ;
    rdfs:range sc:Batch .

sc:shipsItem
    a owl:ObjectProperty ;
    rdfs:subPropertyOf provider:handlesProduct ;
    rdfs:label "ships item"@en ;
    rdfs:domain sc:TransportationProcess ;
    rdfs:range sc:MaterialItem .

sc:producesItem
    a owl:ObjectProperty ;
    rdfs:subPropertyOf provider:hasOutput ;
    rdfs:label "produces item"@en ;
    rdfs:domain sc:ManufacturingProcess ;
    rdfs:range sc:MaterialItem .

sc:consumesItem
    a owl:ObjectProperty ;
    rdfs:subPropertyOf provider:hasInput ;
    rdfs:label "consumes item"@en ;
    rdfs:domain sc:ManufacturingProcess ;
    rdfs:range sc:MaterialItem .

sc:hasDocument
    a owl:ObjectProperty ;
    rdfs:label "has document"@en ;
    rdfs:domain sc:SupplyChainProcess ;
    rdfs:range sc:SupplyChainInformationEntity .

sc:hasQuality
    a owl:ObjectProperty ;
    rdfs:label "has quality"@en ;
    rdfs:range sc:SupplyChainQuality .


#################################################################
# Datatype properties
#################################################################

sc:identifierValue
    a owl:DatatypeProperty ;
    rdfs:subPropertyOf provider:identifier ;
    rdfs:label "identifier value"@en ;
    rdfs:domain sc:Identifier ;
    rdfs:range xsd:string .

sc:orderNumber
    a owl:DatatypeProperty ;
    rdfs:subPropertyOf provider:identifier ;
    rdfs:label "order number"@en ;
    rdfs:domain sc:Order ;
    rdfs:range xsd:string .

sc:skuCode
    a owl:DatatypeProperty ;
    rdfs:subPropertyOf provider:identifier ;
    rdfs:label "SKU code"@en ;
    rdfs:domain sc:SKU ;
    rdfs:range xsd:string .

sc:quantityValue
    a owl:DatatypeProperty ;
    rdfs:subPropertyOf provider:value ;
    rdfs:label "quantity value"@en ;
    rdfs:range xsd:decimal .

sc:unitOfMeasure
    a owl:DatatypeProperty ;
    rdfs:subPropertyOf provider:unit ;
    rdfs:label "unit of measure"@en ;
    rdfs:domain sc:SupplyChainQuality ;
    rdfs:range xsd:string .

sc:plannedStartDate
    a owl:DatatypeProperty ;
    rdfs:label "planned start date"@en ;
    rdfs:domain sc:SupplyChainProcess ;
    rdfs:range xsd:dateTime .

sc:plannedEndDate
    a owl:DatatypeProperty ;
    rdfs:label "planned end date"@en ;
    rdfs:domain sc:SupplyChainProcess ;
    rdfs:range xsd:dateTime .

sc:actualStartDate
    a owl:DatatypeProperty ;
    rdfs:subPropertyOf provider:startTime ;
    rdfs:label "actual start date"@en ;
    rdfs:domain sc:SupplyChainProcess ;
    rdfs:range xsd:dateTime .

sc:actualEndDate
    a owl:DatatypeProperty ;
    rdfs:subPropertyOf provider:endTime ;
    rdfs:label "actual end date"@en ;
    rdfs:domain sc:SupplyChainProcess ;
    rdfs:range xsd:dateTime .

sc:statusValue
    a owl:DatatypeProperty ;
    rdfs:subPropertyOf provider:value ;
    rdfs:label "status value"@en ;
    rdfs:domain sc:SupplyChainQuality ;
    rdfs:range xsd:string .


#################################################################
# Useful restrictions
#################################################################

sc:PurchaseOrder
    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty sc:hasSupplier ;
          owl:someValuesFrom sc:Organization
        ],
        [ a owl:Restriction ;
          owl:onProperty sc:ordersProduct ;
          owl:someValuesFrom sc:Product
        ] .

sc:TransportationProcess
    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty sc:hasOrigin ;
          owl:someValuesFrom [ owl:unionOf ( sc:Location sc:Facility provider:Region ) ]
        ],
        [ a owl:Restriction ;
          owl:onProperty sc:hasDestination ;
          owl:someValuesFrom [ owl:unionOf ( sc:Location sc:Facility provider:Region ) ]
        ],
        [ a owl:Restriction ;
          owl:onProperty sc:shipsItem ;
          owl:someValuesFrom sc:MaterialItem
        ] .

sc:ManufacturingProcess
    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty sc:producesItem ;
          owl:someValuesFrom sc:MaterialItem
        ] .

sc:Inventory
    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty sc:storedAt ;
          owl:someValuesFrom [ owl:unionOf ( sc:Facility sc:Location provider:Region ) ]
        ] .

sc:Facility
    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty provider:locatedIn ;
          owl:someValuesFrom provider:Region
        ] .


#################################################################
# Alignment notes
#################################################################

sc:Organization skos:scopeNote "Use provider:Organization as the canonical class in new core-level data. The sc: alias is retained for supply-chain datasets."@en .
sc:Facility skos:scopeNote "Use provider:Facility as the canonical class in new core-level data. The sc: alias is retained for supply-chain datasets."@en .
sc:Product skos:scopeNote "Use provider:Product as the canonical class in new core-level data. The sc: alias is retained for supply-chain datasets."@en .
