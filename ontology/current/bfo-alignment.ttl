@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix provider: <https://projekt-provider.de/ontology/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://purl.obolibrary.org/obo/BFO_0000002> rdfs:label "continuant"@en .

<http://purl.obolibrary.org/obo/BFO_0000003> rdfs:label "occurrent"@en .

<http://purl.obolibrary.org/obo/BFO_0000019> rdfs:label "quality"@en .

<http://purl.obolibrary.org/obo/BFO_0000029> rdfs:label "site"@en .

provider:Actor rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> ;
    skos:scopeNote "An actor is treated as a material entity when it denotes a person, organization, institution, or organized group participating in a supply chain."@en .

provider:Agent rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000004> ;
    skos:scopeNote "Aligned broadly as an independent continuant because PROVIDER agents include people, organizations, institutions, or organized groups."@en .

provider:AgriculturalSector rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000141> .

provider:AvailabilityImpact rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .

provider:BiologicalEvent rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> .

provider:BufferStockAction rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> .

provider:Carrier rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000027> ;
    skos:scopeNote "Deprecated convenience class. Prefer an :Organization bearing :CarrierRole."@en .

provider:CarrierRole rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> .

provider:CommercialOrganisation rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000027> ;
    skos:scopeNote "Deprecated compatibility class. Prefer :Organization with explicit supply-chain roles."@en .

provider:Commodity rdfs:subClassOf provider:Product ;
    skos:scopeNote "Not directly placed under material entity because some commodities, such as electricity or certificates, may be non-material or information-bearing market objects."@en .

provider:CommunicationInfrastructureAsset rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> .

provider:CostImpact rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .

provider:CustomerRole rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> .

provider:DataSource rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> ;
    skos:scopeNote "A data source may be a database, document, sensor system, organization, or service; this broad alignment should be specialized by implementation modules."@en .

provider:DelayImpact rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .

provider:DisasterEvent rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> .

provider:DisruptionEvent rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> .

provider:DiversificationAction rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> .

provider:EmergencyProcurementAction rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> .

provider:EnergyInfrastructureAsset rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> .

provider:EnergySector rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000141> .

provider:Event rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:scopeNote "In this alignment, events are treated as processes or processual happenings with temporal extent."@en .

provider:Exposure rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000020> ;
    skos:scopeNote "Exposure is aligned as a specifically dependent continuant because it characterizes an entity's situated relation to a hazard, region, process, or dependency."@en .

provider:Facility rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> ;
    skos:scopeNote "A facility is treated as a material entity; site-like aspects can be modeled separately with BFO site if needed."@en .

provider:Farm rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> ;
    skos:scopeNote "A farm is aligned as a facility/site for agricultural production. Farm businesses are organizations bearing farmer or producer roles."@en .

provider:FarmerRole rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> .

provider:Flow rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:scopeNote "A flow is treated as a process involving movement, transfer, or exchange over time."@en .

provider:Hazard rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> ;
    skos:scopeNote "Hazard is kept broad because hazards may be represented as processes, material conditions, environmental states, or information-bearing hazard classes."@en .

provider:Impact rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> ;
    skos:scopeNote "Impact is left broad because PROVIDER may use it for actual consequences, potential consequences, qualitative states, or recorded assessments. Subclasses should distinguish realized impact processes, impact qualities, and impact reports where needed."@en .

provider:Indicator rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000031> ;
    skos:scopeNote "An indicator is treated as an information artifact or specification for what is measured or derived."@en .

provider:InfrastructureAsset rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> ;
    skos:scopeNote "Physical infrastructure assets from OSM-derived modules should normally be material entities, objects, or object aggregates depending on granularity."@en .

provider:InfrastructureOutageEvent rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> .

provider:LogisticsEvent rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> .

provider:LogisticsSector rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000141> .

provider:ManufacturerRole rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> .

provider:MarketEvent rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> .

provider:MarketShockEvent rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> .

provider:MitigationAction rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:scopeNote "A mitigation action is a process intentionally carried out to reduce risk or impact."@en .

provider:MonitoringSignal rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000031> .

provider:Network rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000027> ;
    skos:scopeNote "A network is aligned as an object aggregate when it denotes a connected physical system of infrastructure elements. Logical or planned network descriptions may be represented as information content in a later refinement."@en .

provider:Observation rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000031> ;
    skos:scopeNote "An observation record is treated as a generically dependent continuant. The observing act itself can be modeled as a process."@en .

provider:Organisation rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000027> ;
    skos:scopeNote "Deprecated spelling alias of :Organization."@en .

provider:Organization rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000027> ;
    skos:scopeNote "An organization is aligned as an object aggregate: a social/material aggregate of people, assets, and institutional parts."@en .

provider:Person rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000030> .

provider:PolicyEvent rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> .

provider:PriceRiseEvent rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> .

provider:Process rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> .

provider:ProcessingFacility rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> .

provider:ProcessingSector rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000141> .

provider:Processor rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000027> ;
    skos:scopeNote "Deprecated convenience class. Prefer an :Organization bearing :ProcessorRole."@en .

provider:ProcessorRole rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> .

provider:Producer rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000027> ;
    skos:scopeNote "Deprecated convenience class. Prefer an :Organization bearing :ProducerRole."@en .

provider:ProducerRole rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> .

provider:PublicSector rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000141> .

provider:QualityImpact rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .

provider:Region rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000141> ;
    skos:scopeNote "Aligned as an immaterial entity because PROVIDER regions may be administrative, economic, or analytic regions rather than physical sites alone. Concrete geospatial sites may be modeled as a specialization aligned to bfo:BFO_0000029."@en .

provider:Regulator rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000027> ;
    skos:scopeNote "Deprecated convenience class. Prefer an :Organization bearing :RegulatorRole."@en .

provider:RegulatorRole rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> .

provider:ReroutingAction rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> .

provider:ResilienceCapability rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000016> ;
    skos:scopeNote "A resilience capability is aligned as a realizable disposition-like capability to anticipate, absorb, adapt, recover, or transform."@en .

provider:Retailer rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000027> ;
    skos:scopeNote "Deprecated convenience class. Prefer an :Organization bearing :RetailerRole."@en .

provider:RetailerRole rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> .

provider:Risk rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000016> ;
    skos:scopeNote "Risk is aligned as a disposition-like dependent continuant: a realizable tendency toward adverse outcomes under triggering conditions. Quantified risk assessments can be represented as information artifacts."@en .

provider:Role rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> .

provider:Route rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000031> ;
    skos:scopeNote "A route is treated as an information-bearing planned or observed path. A physical corridor or navigable site may be modeled separately as a site or infrastructure asset."@en .

provider:Sector rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000141> ;
    skos:scopeNote "A sector is treated as an immaterial social/analytic entity aggregating recurrent functions, actors, and infrastructure."@en .

provider:StorageFacility rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> .

provider:StorageInfrastructureAsset rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> .

provider:SubstitutionAction rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> .

provider:SupplierRole rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> .

provider:SupplyChain rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000031> ;
    skos:scopeNote "Aligned as a generically dependent continuant because a supply-chain model or arrangement can be represented, copied, and maintained across actors and information systems. A realized physical supply-chain operation can be modeled as a process."@en .

provider:SupplyChainRole rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> .

provider:SupplyChainStage rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000031> ;
    skos:scopeNote "A stage is an informational or organizational part of a supply-chain model. Concrete execution of a stage is modeled as a process."@en .

provider:SupplyShortageImpact rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .

provider:TradeSector rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000141> .

provider:Trader rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000027> ;
    skos:scopeNote "Deprecated convenience class. Prefer an :Organization bearing :TraderRole."@en .

provider:TraderRole rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> .

provider:TransferFacility rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> .

provider:TransportInfrastructureAsset rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> .

provider:Vulnerability rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000016> ;
    skos:scopeNote "A vulnerability is aligned as a disposition-like susceptibility to adverse outcomes under triggering conditions."@en .

provider:WarehouseOperatorRole rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> .

provider:WeatherEvent rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> .

provider:Wholesaler rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000027> ;
    skos:scopeNote "Deprecated compatibility class. Prefer :Organization with explicit supply-chain roles."@en .

provider:bfo-alignment a owl:Ontology ;
    rdfs:label "PROVIDER BFO Alignment"@en ;
    dct:created "2026-05-26"^^xsd:date ;
    dct:license <https://opensource.org/license/mit> ;
    dct:modified "2026-10-14"^^xsd:date ;
    rdfs:comment """
        Alignment module that places PROVIDER core classes under Basic Formal
        Ontology (BFO) categories. The mappings are intentionally conservative:
        they use subclass axioms and explanatory scope notes rather than
        equivalence axioms.
    """@en ;
    owl:imports provider: ;
    owl:versionIRI <https://projekt-provider.de/ontology/releases/0.3.0-rc3/bfo-alignment> ;
    owl:versionInfo "0.3.0-rc3" .

<http://purl.obolibrary.org/obo/BFO_0000004> rdfs:label "independent continuant"@en .

<http://purl.obolibrary.org/obo/BFO_0000020> rdfs:label "specifically dependent continuant"@en .

<http://purl.obolibrary.org/obo/BFO_0000030> rdfs:label "object"@en .

provider:Product rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> ;
    skos:scopeNote "Kept at BFO entity because PROVIDER products may include material goods, energy products, digital products, certificates, or services. Use a material-product specialization for strictly physical goods."@en .

<http://purl.obolibrary.org/obo/BFO_0000016> rdfs:label "disposition"@en .

<http://purl.obolibrary.org/obo/BFO_0000031> rdfs:label "generically dependent continuant"@en .

<http://purl.obolibrary.org/obo/BFO_0000141> rdfs:label "immaterial entity"@en .

<http://purl.obolibrary.org/obo/BFO_0000001> rdfs:label "entity"@en .

<http://purl.obolibrary.org/obo/BFO_0000027> rdfs:label "object aggregate"@en .

<http://purl.obolibrary.org/obo/BFO_0000040> rdfs:label "material entity"@en .

<http://purl.obolibrary.org/obo/BFO_0000023> rdfs:label "role"@en .

<http://purl.obolibrary.org/obo/BFO_0000015> rdfs:label "process"@en .


provider:bfo-alignment owl:imports <http://purl.obolibrary.org/obo/bfo.owl> .
