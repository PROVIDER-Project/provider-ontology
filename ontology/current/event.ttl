@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix infra: <https://projekt-provider.de/ontology/infrastructure#> .
@prefix ns1: <https://projekt-provider.de/ontology/event#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix provider: <https://projekt-provider.de/ontology/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://projekt-provider.de/ontology/conflict#CivilianGroup> a owl:Class ;
    rdfs:label "Civilian Group"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/conflict#ConflictActor> .

<https://projekt-provider.de/ontology/conflict#ConflictEventImpactAssessment> a owl:Class ;
    rdfs:label "Conflict Event Impact Assessment"@en ;
    rdfs:comment "An event impact assessment based on an actual conflict, protest, riot, battle, explosion, remote violence, or strategic development event."@en ;
    rdfs:subClassOf ns1:EventImpactAssessment .

<https://projekt-provider.de/ontology/conflict#ExternalOtherForce> a owl:Class ;
    rdfs:label "External or Other Force"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/conflict#ConflictActor> .

<https://projekt-provider.de/ontology/conflict#IdentityMilitia> a owl:Class ;
    rdfs:label "Identity Militia"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/conflict#ConflictActor> .

<https://projekt-provider.de/ontology/conflict#NonStateArmedGroup> a owl:Class ;
    rdfs:label "Non-State Armed Group"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/conflict#ConflictActor> .

<https://projekt-provider.de/ontology/conflict#PoliticalMilitia> a owl:Class ;
    rdfs:label "Political Militia"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/conflict#ConflictActor> .

<https://projekt-provider.de/ontology/conflict#ProtesterGroup> a owl:Class ;
    rdfs:label "Protester Group"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/conflict#ConflictActor> .

<https://projekt-provider.de/ontology/conflict#StateForce> a owl:Class ;
    rdfs:label "State Force"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/conflict#ConflictActor> .

<https://projekt-provider.de/ontology/conflict#acledEventId> a owl:DatatypeProperty ;
    rdfs:label "ACLED event identifier"@en ;
    rdfs:domain <https://projekt-provider.de/ontology/conflict#ConflictEvent> ;
    rdfs:range xsd:string .

<https://projekt-provider.de/ontology/conflict#acledEventType> a owl:ObjectProperty ;
    rdfs:label "ACLED event type"@en ;
    rdfs:domain <https://projekt-provider.de/ontology/conflict#ConflictEvent> ;
    rdfs:range skos:Concept .

<https://projekt-provider.de/ontology/conflict#acledGeoPrecision> a owl:DatatypeProperty ;
    rdfs:label "ACLED geographic precision"@en ;
    rdfs:domain <https://projekt-provider.de/ontology/conflict#ConflictEvent> ;
    rdfs:range xsd:integer .

<https://projekt-provider.de/ontology/conflict#acledInteractionCode> a owl:DatatypeProperty ;
    rdfs:label "ACLED interaction code"@en ;
    rdfs:domain <https://projekt-provider.de/ontology/conflict#ConflictEvent> ;
    rdfs:range xsd:string .

<https://projekt-provider.de/ontology/conflict#acledSubEventType> a owl:ObjectProperty ;
    rdfs:label "ACLED sub-event type"@en ;
    rdfs:domain <https://projekt-provider.de/ontology/conflict#ConflictEvent> ;
    rdfs:range skos:Concept .

<https://projekt-provider.de/ontology/conflict#acledTimePrecision> a owl:DatatypeProperty ;
    rdfs:label "ACLED time precision"@en ;
    rdfs:domain <https://projekt-provider.de/ontology/conflict#ConflictEvent> ;
    rdfs:range xsd:integer .

<https://projekt-provider.de/ontology/conflict#admin1Name> a owl:DatatypeProperty ;
    rdfs:label "first-level administrative unit name"@en ;
    rdfs:domain <https://projekt-provider.de/ontology/conflict#ConflictEvent> ;
    rdfs:range xsd:string .

<https://projekt-provider.de/ontology/conflict#admin2Name> a owl:DatatypeProperty ;
    rdfs:label "second-level administrative unit name"@en ;
    rdfs:domain <https://projekt-provider.de/ontology/conflict#ConflictEvent> ;
    rdfs:range xsd:string .

<https://projekt-provider.de/ontology/conflict#admin3Name> a owl:DatatypeProperty ;
    rdfs:label "third-level administrative unit name"@en ;
    rdfs:domain <https://projekt-provider.de/ontology/conflict#ConflictEvent> ;
    rdfs:range xsd:string .

<https://projekt-provider.de/ontology/conflict#civilianTargeting> a owl:DatatypeProperty ;
    rdfs:label "civilian targeting"@en ;
    rdfs:domain <https://projekt-provider.de/ontology/conflict#ConflictEvent> ;
    rdfs:range xsd:boolean .

<https://projekt-provider.de/ontology/conflict#conflictExposureClass> a owl:DatatypeProperty ;
    rdfs:label "conflict exposure class"@en ;
    rdfs:domain <https://projekt-provider.de/ontology/conflict#ConflictExposureAssessment> ;
    rdfs:range xsd:string .

<https://projekt-provider.de/ontology/conflict#conflictExposureScore> a owl:DatatypeProperty ;
    rdfs:label "conflict exposure score"@en ;
    rdfs:domain <https://projekt-provider.de/ontology/conflict#ConflictExposureAssessment> ;
    rdfs:range xsd:decimal .

<https://projekt-provider.de/ontology/conflict#eventCount> a owl:DatatypeProperty ;
    rdfs:label "event count"@en ;
    rdfs:domain <https://projekt-provider.de/ontology/conflict#ConflictExposureAssessment> ;
    rdfs:range xsd:integer .

<https://projekt-provider.de/ontology/conflict#fatalities> a owl:DatatypeProperty ;
    rdfs:label "fatalities"@en ;
    rdfs:domain <https://projekt-provider.de/ontology/conflict#ConflictEvent> ;
    rdfs:range xsd:integer .

<https://projekt-provider.de/ontology/conflict#fatalityCount> a owl:DatatypeProperty ;
    rdfs:label "fatality count"@en ;
    rdfs:domain <https://projekt-provider.de/ontology/conflict#ConflictExposureAssessment> ;
    rdfs:range xsd:integer .

<https://projekt-provider.de/ontology/conflict#hasPrimaryActor> a owl:ObjectProperty ;
    rdfs:label "has primary actor"@en ;
    rdfs:domain <https://projekt-provider.de/ontology/conflict#ConflictEvent> ;
    rdfs:range <https://projekt-provider.de/ontology/conflict#ConflictActor> ;
    rdfs:subPropertyOf <https://projekt-provider.de/ontology/conflict#hasActor> .

<https://projekt-provider.de/ontology/conflict#hasSecondaryActor> a owl:ObjectProperty ;
    rdfs:label "has secondary actor"@en ;
    rdfs:domain <https://projekt-provider.de/ontology/conflict#ConflictEvent> ;
    rdfs:range <https://projekt-provider.de/ontology/conflict#ConflictActor> ;
    rdfs:subPropertyOf <https://projekt-provider.de/ontology/conflict#hasActor> .

<https://projekt-provider.de/ontology/conflict#lookbackPeriodDays> a owl:DatatypeProperty ;
    rdfs:label "lookback period in days"@en ;
    rdfs:domain <https://projekt-provider.de/ontology/conflict#ConflictExposureAssessment> ;
    rdfs:range xsd:integer .

<https://projekt-provider.de/ontology/conflict#notes> a owl:DatatypeProperty ;
    rdfs:label "notes"@en ;
    rdfs:domain <https://projekt-provider.de/ontology/conflict#ConflictEvent> ;
    rdfs:range xsd:string .

<https://projekt-provider.de/ontology/conflict#sourceScale> a owl:DatatypeProperty ;
    rdfs:label "source scale"@en ;
    rdfs:domain <https://projekt-provider.de/ontology/conflict#ConflictEvent> ;
    rdfs:range xsd:string .

provider:event a owl:Ontology ;
    rdfs:label "PROVIDER event"@en ;
    dct:created "2026-06-09"^^xsd:date ;
    dct:creator "PROVIDER project"@en ;
    dct:description "Ontology module for modeling disruption-relevant events in the PROVIDER knowledge graph, including generic disruption events, natural hazard events and alerts such as GDACS, baseline hazard layers such as flood and seismic hazard maps, asset-level hazard exposure assessments, conflict/security events such as ACLED records, and event impact assessments for supply-chain resilience analysis."@en ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:modified "2026-10-14"^^xsd:date ;
    dct:title "PROVIDER Event, Hazard, Conflict, and Exposure Ontology"@en ;
    rdfs:seeAlso <http://www.opengis.net/ont/geosparql>,
        <http://www.w3.org/2006/time>,
        <http://www.w3.org/ns/dcat>,
        <http://www.w3.org/ns/prov>,
        schema: ;
    owl:imports provider:,
        provider:infrastructure ;
    owl:versionIRI <https://projekt-provider.de/ontology/releases/0.3.0-rc3/event> ;
    owl:versionInfo "0.3.0-rc3" .

ns1:AirportDisruptionEvent a owl:Class ;
    rdfs:label "Airport Disruption Event"@en ;
    rdfs:subClassOf ns1:TransportDisruptionEvent .

ns1:BorderClosureEvent a owl:Class ;
    rdfs:label "Border Closure Event"@en ;
    rdfs:subClassOf ns1:RegulatoryDisruptionEvent .

ns1:CyberIncidentEvent a owl:Class ;
    rdfs:label "Cyber Incident Event"@en ;
    rdfs:subClassOf ns1:DisruptionEvent .

ns1:ExportRestrictionEvent a owl:Class ;
    rdfs:label "Export Restriction Event"@en ;
    rdfs:subClassOf ns1:RegulatoryDisruptionEvent .

ns1:ImportBanEvent a owl:Class ;
    rdfs:label "Import Ban Event"@en ;
    rdfs:subClassOf ns1:RegulatoryDisruptionEvent .

ns1:PipelineDisruptionEvent a owl:Class ;
    rdfs:label "Pipeline Disruption Event"@en ;
    rdfs:subClassOf ns1:InfrastructureDisruptionEvent .

ns1:PortClosureEvent a owl:Class ;
    rdfs:label "Port Closure Event"@en ;
    rdfs:subClassOf ns1:TransportDisruptionEvent .

ns1:PowerOutageEvent a owl:Class ;
    rdfs:label "Power Outage Event"@en ;
    rdfs:subClassOf ns1:InfrastructureDisruptionEvent .

ns1:RailDisruptionEvent a owl:Class ;
    rdfs:label "Rail Disruption Event"@en ;
    rdfs:subClassOf ns1:TransportDisruptionEvent .

ns1:RoadClosureEvent a owl:Class ;
    rdfs:label "Road Closure Event"@en ;
    rdfs:subClassOf ns1:TransportDisruptionEvent .

ns1:SanctionEvent a owl:Class ;
    rdfs:label "Sanction Event"@en ;
    rdfs:subClassOf ns1:RegulatoryDisruptionEvent .

ns1:assessedAt a owl:DatatypeProperty ;
    rdfs:label "assessed at"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:dateTime .

ns1:assessesAsset a owl:ObjectProperty ;
    rdfs:label "assesses asset"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range provider:InfrastructureAsset ;
    rdfs:subPropertyOf ns1:assessesEntity .

ns1:assessesImpactOf a owl:ObjectProperty ;
    rdfs:label "assesses impact of"@en ;
    rdfs:domain ns1:EventImpactAssessment ;
    rdfs:range ns1:DisruptionEvent .

ns1:assessesRegion a owl:ObjectProperty ;
    rdfs:label "assesses region"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range geo:Feature ;
    rdfs:subPropertyOf ns1:assessesEntity .

ns1:assessesRoute a owl:ObjectProperty ;
    rdfs:label "assesses route"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range provider:Route ;
    rdfs:subPropertyOf ns1:assessesEntity .

ns1:assessesSupplyChainNode a owl:ObjectProperty ;
    rdfs:label "assesses supply chain node"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing ;
    rdfs:subPropertyOf ns1:assessesEntity .

ns1:assessmentMethod a owl:DatatypeProperty ;
    rdfs:label "assessment method"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

ns1:confidence a owl:DatatypeProperty ;
    rdfs:label "confidence"@en ;
    rdfs:comment "Confidence score in the range 0 to 1 where applicable."@en ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:decimal .

ns1:coverageFraction a owl:DatatypeProperty ;
    rdfs:label "coverage fraction"@en ;
    rdfs:comment "Fraction of the assessed geometry covered by a hazard layer, event footprint, conflict buffer, or affected area."@en ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:decimal .

ns1:dataVersion a owl:DatatypeProperty ;
    rdfs:label "data version"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

ns1:distanceMeters a owl:DatatypeProperty ;
    rdfs:label "distance in meters"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:decimal .

ns1:endedAt a owl:DatatypeProperty ;
    rdfs:label "ended at"@en ;
    rdfs:domain ns1:Event ;
    rdfs:range xsd:dateTime .

ns1:hasAffectedArea a owl:ObjectProperty ;
    rdfs:label "has affected area"@en ;
    rdfs:comment "Links a disruption event to a footprint, alert area, buffer, administrative region, or modeled affected area."@en ;
    rdfs:domain ns1:DisruptionEvent ;
    rdfs:range geo:Feature .

ns1:hasEventTime a owl:ObjectProperty ;
    rdfs:label "has event time"@en ;
    rdfs:domain ns1:Event ;
    rdfs:range time:TemporalEntity .

ns1:hasLocation a owl:ObjectProperty ;
    rdfs:label "has location"@en ;
    rdfs:comment "Links an event to a spatial feature representing its location, epicenter, centroid, reported place, or source-specific location."@en ;
    rdfs:domain ns1:Event ;
    rdfs:range geo:Feature .

ns1:hasSeverity a owl:DatatypeProperty ;
    rdfs:label "has severity"@en ;
    rdfs:domain ns1:DisruptionEvent ;
    rdfs:range xsd:decimal .

ns1:impactClass a owl:DatatypeProperty ;
    rdfs:label "impact class"@en ;
    rdfs:domain ns1:EventImpactAssessment ;
    rdfs:range xsd:string .

ns1:impactScore a owl:DatatypeProperty ;
    rdfs:label "impact score"@en ;
    rdfs:domain ns1:EventImpactAssessment ;
    rdfs:range xsd:decimal .

ns1:ingestedAt a owl:DatatypeProperty ;
    rdfs:label "ingested at"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:dateTime .

ns1:locatedInCountry a owl:ObjectProperty ;
    rdfs:label "located in country"@en ;
    rdfs:domain ns1:Event ;
    rdfs:range provider:Country .

ns1:locatedInRegion a owl:ObjectProperty ;
    rdfs:label "located in region"@en ;
    rdfs:domain ns1:Event ;
    rdfs:range geo:Feature .

ns1:modelingNote a owl:AnnotationProperty ;
    rdfs:label "modeling note"@en ;
    rdfs:comment "A modeling note intended for ontology maintainers and data engineers."@en .

ns1:occurredOn a owl:DatatypeProperty ;
    rdfs:label "occurred on"@en ;
    rdfs:domain ns1:Event ;
    rdfs:range xsd:date .

ns1:recommendedMapping a owl:AnnotationProperty ;
    rdfs:label "recommended mapping"@en ;
    rdfs:comment "Human-readable implementation guidance for ETL mappings into this ontology."@en .

ns1:severityClass a owl:DatatypeProperty ;
    rdfs:label "severity class"@en ;
    rdfs:comment "Categorical severity, preferably normalized to a PROVIDER-controlled vocabulary while preserving the source value separately."@en ;
    rdfs:domain ns1:DisruptionEvent ;
    rdfs:range xsd:string .

ns1:sourceDataset a owl:ObjectProperty ;
    rdfs:label "source dataset"@en ;
    rdfs:domain ns1:Event ;
    rdfs:range dcat:Dataset .

ns1:sourceProvider a owl:DatatypeProperty ;
    rdfs:label "source provider"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

ns1:sourceRecordId a owl:DatatypeProperty ;
    rdfs:label "source record identifier"@en ;
    rdfs:comment "Identifier of the source-system record from which the event was created, for example a GDACS event id or ACLED event id."@en ;
    rdfs:domain ns1:Event ;
    rdfs:range xsd:string .

ns1:sourceUrl a owl:DatatypeProperty ;
    rdfs:label "source URL"@en ;
    rdfs:domain ns1:Event ;
    rdfs:range xsd:anyURI .

ns1:startedAt a owl:DatatypeProperty ;
    rdfs:label "started at"@en ;
    rdfs:domain ns1:Event ;
    rdfs:range xsd:dateTime .

<https://projekt-provider.de/ontology/hazard#AssetExposureAssessment> a owl:Class ;
    rdfs:label "Asset Exposure Assessment"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/hazard#HazardExposureAssessment> .

<https://projekt-provider.de/ontology/hazard#BaselineHazardDataset> a owl:Class ;
    rdfs:label "Baseline Hazard Dataset"@en ;
    rdfs:comment "A dataset describing estimated, modeled, or probabilistic hazard intensity over space, for example flood depth by return period or seismic peak ground acceleration."@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/hazard#HazardDataset> .

<https://projekt-provider.de/ontology/hazard#CycloneWindHazardLayer> a owl:Class ;
    rdfs:label "Cyclone Wind Hazard Layer"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/hazard#RasterHazardLayer> .

<https://projekt-provider.de/ontology/hazard#DroughtEvent> a owl:Class ;
    rdfs:label "Drought Event"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/hazard#HazardEvent> .

<https://projekt-provider.de/ontology/hazard#DroughtHazardLayer> a owl:Class ;
    rdfs:label "Drought Hazard Layer"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/hazard#RasterHazardLayer> .

<https://projekt-provider.de/ontology/hazard#EarlyWarningAlert> a owl:Class ;
    rdfs:label "Early Warning Alert"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/hazard#HazardAlert> .

<https://projekt-provider.de/ontology/hazard#EventDataset> a owl:Class ;
    rdfs:label "Event Dataset"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/hazard#HazardDataset> .

<https://projekt-provider.de/ontology/hazard#FaultZoneLayer> a owl:Class ;
    rdfs:label "Fault Zone Layer"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/hazard#VectorHazardLayer> .

<https://projekt-provider.de/ontology/hazard#FloodEvent> a owl:Class ;
    rdfs:label "Flood Event"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/hazard#HazardEvent> .

<https://projekt-provider.de/ontology/hazard#FloodHazardLayer> a owl:Class ;
    rdfs:label "Flood Hazard Layer"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/hazard#RasterHazardLayer> .

<https://projekt-provider.de/ontology/hazard#FloodObservation> a owl:Class ;
    rdfs:label "Flood Observation"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/hazard#HazardObservation> .

<https://projekt-provider.de/ontology/hazard#GDACSAlert> a owl:Class ;
    rdfs:label "GDACS Alert"@en ;
    rdfs:comment "An alert record issued by the Global Disaster Alert and Coordination System."@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/hazard#HazardAlert> ;
    ns1:recommendedMapping "Map GDACS alert-level records to provhaz:GDACSAlert and link them to the corresponding provhaz:HazardEvent using provhaz:alertsAbout and provhaz:hasAlert."@en .

<https://projekt-provider.de/ontology/hazard#HazardEventImpactAssessment> a owl:Class ;
    rdfs:label "Hazard Event Impact Assessment"@en ;
    rdfs:comment "An event impact assessment based on an actual hazard event such as a GDACS flood, earthquake, cyclone, or wildfire event."@en ;
    rdfs:subClassOf ns1:EventImpactAssessment .

<https://projekt-provider.de/ontology/hazard#HazardZoneLayer> a owl:Class ;
    rdfs:label "Hazard Zone Layer"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/hazard#VectorHazardLayer> .

<https://projekt-provider.de/ontology/hazard#HistoricalHazardDataset> a owl:Class ;
    rdfs:label "Historical Hazard Dataset"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/hazard#HazardDataset> .

<https://projekt-provider.de/ontology/hazard#LandslideEvent> a owl:Class ;
    rdfs:label "Landslide Event"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/hazard#HazardEvent> .

<https://projekt-provider.de/ontology/hazard#ObservationAlert> a owl:Class ;
    rdfs:label "Observation Alert"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/hazard#HazardAlert> .

<https://projekt-provider.de/ontology/hazard#ObservationDataset> a owl:Class ;
    rdfs:label "Observation Dataset"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/hazard#HazardDataset> .

<https://projekt-provider.de/ontology/hazard#RegionalExposureAssessment> a owl:Class ;
    rdfs:label "Regional Exposure Assessment"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/hazard#HazardExposureAssessment> .

<https://projekt-provider.de/ontology/hazard#SeismicHazardLayer> a owl:Class ;
    rdfs:label "Seismic Hazard Layer"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/hazard#RasterHazardLayer> .

<https://projekt-provider.de/ontology/hazard#SeismicObservation> a owl:Class ;
    rdfs:label "Seismic Observation"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/hazard#HazardObservation> .

<https://projekt-provider.de/ontology/hazard#SupplyChainNodeExposureAssessment> a owl:Class ;
    rdfs:label "Supply Chain Node Exposure Assessment"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/hazard#HazardExposureAssessment> .

<https://projekt-provider.de/ontology/hazard#TransportCorridorExposureAssessment> a owl:Class ;
    rdfs:label "Transport Corridor Exposure Assessment"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/hazard#HazardExposureAssessment> .

<https://projekt-provider.de/ontology/hazard#TsunamiEvent> a owl:Class ;
    rdfs:label "Tsunami Event"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/hazard#HazardEvent> .

<https://projekt-provider.de/ontology/hazard#VolcanicEvent> a owl:Class ;
    rdfs:label "Volcanic Event"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/hazard#HazardEvent> .

<https://projekt-provider.de/ontology/hazard#VolcanoInventoryLayer> a owl:Class ;
    rdfs:label "Volcano Inventory Layer"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/hazard#VectorHazardLayer> .

<https://projekt-provider.de/ontology/hazard#WeatherObservation> a owl:Class ;
    rdfs:label "Weather Observation"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/hazard#HazardObservation> .

<https://projekt-provider.de/ontology/hazard#WildfireEvent> a owl:Class ;
    rdfs:label "Wildfire Event"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/hazard#HazardEvent> .

<https://projekt-provider.de/ontology/hazard#WildfireHazardLayer> a owl:Class ;
    rdfs:label "Wildfire Hazard Layer"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/hazard#RasterHazardLayer> .

<https://projekt-provider.de/ontology/hazard#affectedPopulation> a owl:DatatypeProperty ;
    rdfs:label "affected population"@en ;
    rdfs:domain <https://projekt-provider.de/ontology/hazard#HazardEvent> ;
    rdfs:range xsd:decimal .

<https://projekt-provider.de/ontology/hazard#alertLevel> a owl:DatatypeProperty ;
    rdfs:label "alert level"@en ;
    rdfs:comment "Alert severity level as provided by the source system, for example Green, Orange, or Red in GDACS."@en ;
    rdfs:domain <https://projekt-provider.de/ontology/hazard#HazardAlert> ;
    rdfs:range xsd:string .

<https://projekt-provider.de/ontology/hazard#alertsAbout> a owl:ObjectProperty ;
