ns1:RegulatoryDisruptionEvent a owl:Class ;
    rdfs:label "Regulatory Disruption Event"@en ;
    rdfs:subClassOf ns1:DisruptionEvent .

ns1:TransportDisruptionEvent a owl:Class ;
    rdfs:label "Transport Disruption Event"@en ;
    rdfs:subClassOf ns1:InfrastructureDisruptionEvent .

ns1:assessesEntity a owl:ObjectProperty ;
    rdfs:label "assesses entity"@en ;
    rdfs:comment "The entity being assessed, for example an infrastructure asset, supplier, facility, route, shipment, organization, administrative region, or supply-chain node."@en ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing .

<https://projekt-provider.de/ontology/hazard#MeteorologicalHazard> a owl:Class ;
    rdfs:label "Meteorological Hazard"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/hazard#HazardPhenomenon> .

<https://projekt-provider.de/ontology/hazard#VectorHazardLayer> a owl:Class ;
    rdfs:label "Vector Hazard Layer"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/hazard#HazardLayer> .

<https://projekt-provider.de/ontology/conflict#ConflictExposureAssessment> a owl:Class ;
    rdfs:label "Conflict Exposure Assessment"@en ;
    rdfs:comment "An assessment of an asset, route, region, or supply-chain node based on historical or recent conflict event density, fatalities, actor activity, disorder type, or related conflict/security indicators."@en ;
    rdfs:subClassOf prov:Activity .

<https://projekt-provider.de/ontology/hazard#GeophysicalHazard> a owl:Class ;
    rdfs:label "Geophysical Hazard"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/hazard#HazardPhenomenon> .

<https://projekt-provider.de/ontology/hazard#HydrologicalHazard> a owl:Class ;
    rdfs:label "Hydrological Hazard"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/hazard#HazardPhenomenon> .

<https://projekt-provider.de/ontology/hazard#exposureValue> a owl:DatatypeProperty ;
    rdfs:label "exposure value"@en ;
    rdfs:domain <https://projekt-provider.de/ontology/hazard#HazardExposureAssessment> ;
    rdfs:range xsd:decimal .

ns1:EventImpactAssessment a owl:Class ;
    rdfs:label "Event Impact Assessment"@en ;
    rdfs:comment "An assessment relating a disruption event to a potentially affected asset, route, supply-chain node, region, shipment, organization, or other entity."@en ;
    rdfs:subClassOf prov:Activity .

<https://projekt-provider.de/ontology/hazard#HazardPhenomenon> a owl:Class ;
    rdfs:label "Hazard Phenomenon"@en ;
    rdfs:comment "A category of potentially disruptive natural, environmental, biological, or compound hazard."@en ;
    rdfs:subClassOf skos:Concept .

<https://projekt-provider.de/ontology/hazard#RasterHazardLayer> a owl:Class ;
    rdfs:label "Raster Hazard Layer"@en ;
    rdfs:subClassOf <https://projekt-provider.de/ontology/hazard#HazardLayer> .

<https://projekt-provider.de/ontology/source/acled#EventTypeScheme> a skos:ConceptScheme ;
    dct:description "SKOS representation of broad ACLED event types used by PROVIDER mappings."@en ;
    skos:prefLabel "ACLED event type scheme"@en .

<https://projekt-provider.de/ontology/source/acled#SubEventTypeScheme> a skos:ConceptScheme ;
    skos:prefLabel "ACLED sub-event type scheme"@en .

<https://projekt-provider.de/ontology/hazard#HazardDataset> a owl:Class ;
    rdfs:label "Hazard Dataset"@en ;
    rdfs:comment "A dataset containing hazard events, observations, alerts, baseline hazard layers, historical records, or derived exposure indicators."@en ;
    rdfs:subClassOf dcat:Dataset .

ns1:DisruptionEvent a owl:Class ;
    rdfs:label "Disruption Event"@en ;
    rdfs:comment "An event that may disrupt, damage, delay, constrain, or otherwise affect supply chains, infrastructure, logistics, production, procurement, or demand."@en ;
    rdfs:subClassOf provider:DisruptionEvent,
        ns1:Event ;
    ns1:modelingNote "Use this as the common superclass for hazard events, conflict events, infrastructure disruption events, cyber incidents, regulatory disruption events, and similar supply-chain-relevant events. Do not use HazardEvent as the superclass for conflict events."@en .

<https://projekt-provider.de/ontology/hazard#HazardAlert> a owl:Class ;
    rdfs:label "Hazard Alert"@en ;
    rdfs:comment "A warning, alert, bulletin, or source-provider status record issued for a hazard event or observation."@en ;
    rdfs:subClassOf prov:Entity .

<https://projekt-provider.de/ontology/hazard#HazardObservation> a owl:Class ;
    rdfs:label "Hazard Observation"@en ;
    rdfs:comment "An observation of a hazard-related phenomenon, such as satellite fire detection, rainfall observation, seismic measurement, or flood extent observation. Observations may support event detection but are not necessarily events themselves."@en ;
    rdfs:subClassOf prov:Entity,
        provider:Observation .

<https://projekt-provider.de/ontology/conflict#ConflictActor> a owl:Class ;
    rdfs:label "Conflict Actor"@en ;
    rdfs:comment "An actor participating in or associated with a conflict event, such as a state force, rebel group, militia, political group, protest group, or civilian group."@en .

<https://projekt-provider.de/ontology/hazard#HazardLayer> a owl:Class ;
    rdfs:label "Hazard Layer"@en ;
    rdfs:comment "A spatial layer representing hazard intensity, probability, return period, susceptibility, forecast state, or hazard zones. Baseline hazard layers are not events."@en ;
    rdfs:subClassOf geo:Feature ;
    ns1:modelingNote "Use HazardLayer for flood, seismic, drought, cyclone wind, wildfire-risk, and similar spatial hazard surfaces. Do not model such baseline layers as HazardEvent."@en .

ns1:Event a owl:Class ;
    rdfs:label "Event"@en ;
    rdfs:comment "A temporally situated occurrence that may have a location, spatial extent, source record, participants, observations, and possible impacts."@en ;
    rdfs:subClassOf provider:Event .

<https://projekt-provider.de/ontology/hazard#HazardEvent> a owl:Class ;
    rdfs:label "Hazard Event"@en ;
    rdfs:comment "A hazard occurrence does not by itself establish realized supply-chain disruption or causal impact."@en,
        "A temporally situated natural, environmental, biological, or compound hazard occurrence, such as an earthquake, flood, cyclone, wildfire, drought, volcanic eruption, or landslide."@en ;
    rdfs:subClassOf ns1:Event .

<https://projekt-provider.de/ontology/conflict#ConflictEvent> a owl:Class ;
    rdfs:label "Conflict Event"@en ;
    rdfs:comment "A conflict, political violence, protest, riot, strategic development, or related security event that may affect supply chains, infrastructure, logistics, production, or procurement."@en ;
    rdfs:subClassOf ns1:DisruptionEvent .

<https://projekt-provider.de/ontology/hazard#HazardExposureAssessment> a owl:Class ;
    rdfs:label "Hazard Exposure Assessment"@en ;
    rdfs:comment "An assessment that relates an asset, route, supply-chain node, region, shipment, or organization to a baseline hazard layer or hazard dataset. This is used for potential/modelled hazard exposure, not for actual events."@en ;
    rdfs:subClassOf prov:Activity .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:comment ;
    owl:annotatedSource <https://projekt-provider.de/ontology/hazard#HazardLayer> ;
    owl:annotatedTarget "A spatial layer representing hazard intensity, probability, return period, susceptibility, forecast state, or hazard zones. Baseline hazard layers are not events."@en ;
    ns1:modelingNote "Examples: JRC Global River Flood Hazard return-period raster, World Bank/GFDRR flood depth layer, GEM seismic PGA layer, cyclone wind return-period raster, drought index raster. Materialize full rasters outside RDF and store only metadata plus derived exposure assessments in the KG."@en .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:comment ;
    owl:annotatedSource <https://projekt-provider.de/ontology/conflict#ConflictEvent> ;
    owl:annotatedTarget "A conflict, political violence, protest, riot, strategic development, or related security event that may affect supply chains, infrastructure, logistics, production, or procurement."@en ;
    ns1:modelingNote "ACLED records should be modeled as provconf:ConflictEvent subclasses, not as provhaz:HazardEvent. The shared superclass is provevent:DisruptionEvent."@en .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:comment ;
    owl:annotatedSource ns1:EventImpactAssessment ;
    owl:annotatedTarget "An assessment relating a disruption event to a potentially affected asset, route, supply-chain node, region, shipment, organization, or other entity."@en ;
    ns1:modelingNote "Use EventImpactAssessment for actual events such as GDACS events and ACLED events. Use HazardExposureAssessment for baseline hazard layers, and ConflictExposureAssessment for aggregate exposure to historical/recent conflict patterns."@en .

