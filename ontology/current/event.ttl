ns1:InfrastructureDisruptionEvent a owl:Class ;
    rdfs:label "Infrastructure Disruption Event"@en ;
    rdfs:comment "A disruption event directly affecting infrastructure availability or operation, such as a port closure, road closure, railway outage, power outage, or pipeline outage."@en ;
    rdfs:subClassOf ns1:DisruptionEvent .

