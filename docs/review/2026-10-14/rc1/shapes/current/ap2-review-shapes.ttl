@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix ports: <https://projekt-provider.de/ontology/ports#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://projekt-provider.de/ontology/shapes/ports#AcceptedKindShape> a sh:NodeShape ;
    sh:sparql [ sh:message "Accepted match data kind conflicts with an explicitly classified endpoint." ;
            sh:select """
    PREFIX ap: <https://projekt-provider.de/ontology/ports#>
    SELECT $this WHERE { $this ap:reviewStatus ap:Accepted; ap:dataKind ?kind; ap:subject ?s; ap:object ?o .
      { ?s ap:dataKind ?endpointKind . } UNION { ?o ap:dataKind ?endpointKind . }
      FILTER(?kind != ?endpointKind) }
  """ ] ;
    sh:targetClass ports:MatchAssertion .

<https://projekt-provider.de/ontology/shapes/ports#DataKindShape> a sh:NodeShape ;
    sh:property [ sh:in ( ports:Real ports:Synthetic ) ;
            sh:maxCount 1 ;
            sh:path ports:dataKind ] ;
    sh:targetSubjectsOf ports:dataKind .

<https://projekt-provider.de/ontology/shapes/ports#DistinctRolesShape> a sh:NodeShape ;
    sh:sparql [ sh:message "Source feature, record, trade location, canonical port, terminal and area must remain separate nodes." ;
            sh:select """
    PREFIX ap: <https://projekt-provider.de/ontology/ports#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT $this WHERE { $this a ?type1, ?type2 . ?type1 rdfs:subClassOf* ?role1 . ?type2 rdfs:subClassOf* ?role2 .
      FILTER(?role1 IN (ap:OperationalPort, ap:Terminal, ap:PortArea, ap:TradeLocation, ap:SourceRecord, ap:SourcePortFeature)
        && ?role2 IN (ap:OperationalPort, ap:Terminal, ap:PortArea, ap:TradeLocation, ap:SourceRecord, ap:SourcePortFeature)
        && STR(?role1) < STR(?role2)) }
  """ ] ;
    sh:targetClass ports:OperationalPort,
        ports:PortArea,
        ports:SourcePortFeature,
        ports:SourceRecord,
        ports:Terminal,
        ports:TradeLocation .

<https://projekt-provider.de/ontology/shapes/ports#MatchAssertionShape> a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:or ( [ sh:property [ sh:in ( ports:Pending ports:Rejected ) ;
                        sh:path ports:reviewStatus ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path ports:reviewer ],
                    [ sh:minCount 1 ;
                        sh:path ports:reviewedAt ] ] ) ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path ports:subject ],
        [ sh:in ( ports:Real ports:Synthetic ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ports:dataKind ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path ports:evidence ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path ports:reviewer ;
            sh:pattern "\\S" ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path ports:reviewedAt ;
            sh:pattern "(Z|[+-][0-9]{2}:[0-9]{2})$" ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path ports:object ],
        [ sh:in ( ports:describesOperationalPort ports:servesTradeLocation ports:areaOfPort ports:terminalOfPort ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ports:relation ],
        [ sh:in ( ports:Pending ports:Accepted ports:Rejected ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ports:reviewStatus ] ;
    sh:sparql [ sh:message "Pending or rejected matches must not materialize the proposed relation." ;
            sh:select """
    PREFIX ap: <https://projekt-provider.de/ontology/ports#>
    SELECT $this WHERE { $this ap:subject ?s; ap:relation ?p; ap:object ?o; ap:reviewStatus ?status .
      FILTER(?status IN (ap:Pending, ap:Rejected)) ?s ?p ?o . }
  """ ],
        [ sh:message "Accepted matches need an actual relation and explicitly typed subject/object roles." ;
            sh:select """
    PREFIX ap: <https://projekt-provider.de/ontology/ports#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT $this WHERE { $this ap:subject ?s; ap:relation ?p; ap:object ?o; ap:reviewStatus ap:Accepted .
      FILTER(!EXISTS { ?s ?p ?o . }
       || (?p = ap:describesOperationalPort && !EXISTS { ?s a/rdfs:subClassOf* ap:SourcePortFeature . ?o a/rdfs:subClassOf* ap:OperationalPort . })
       || (?p = ap:servesTradeLocation && !EXISTS { ?s a/rdfs:subClassOf* ap:OperationalPort . ?o a/rdfs:subClassOf* ap:TradeLocation . })
       || (?p = ap:areaOfPort && !EXISTS { ?s a/rdfs:subClassOf* ap:PortArea . ?o a/rdfs:subClassOf* ap:OperationalPort . })
       || (?p = ap:terminalOfPort && !EXISTS { ?s a/rdfs:subClassOf* ap:Terminal . ?o a/rdfs:subClassOf* ap:OperationalPort . })) }
  """ ],
        [ sh:message "Accepted association has conflicting or missing source/canonical country evidence." ;
            sh:select """
    PREFIX ap: <https://projekt-provider.de/ontology/ports#>
    PREFIX pw: <https://portwatch.imf.org/ontology/>
    PREFIX src: <https://projekt-provider.de/ontology/>
    SELECT $this WHERE { $this ap:subject ?s; ap:relation ?p; ap:object ?o; ap:reviewStatus ap:Accepted .
      FILTER((?p = ap:describesOperationalPort && !EXISTS {
         ?s (ap:countryISO3|pw:locatedInCountry/pw:iso3) ?country . ?o ap:countryISO3 ?country . })
        || (?p = ap:servesTradeLocation && !EXISTS { ?s ap:countryISO2 ?country . ?o src:countryCode ?country . })) }
  """ ] ;
    sh:targetClass ports:MatchAssertion .

<https://projekt-provider.de/ontology/shapes/ports#MaterializedRelationShape> a sh:NodeShape ;
    sh:sparql [ sh:message "Each materialized relation requires an accepted evidenced MatchAssertion." ;
            sh:select """
    PREFIX ap: <https://projekt-provider.de/ontology/ports#>
    SELECT $this ?path ?value WHERE {
      $this ?path ?value . FILTER(?path IN (ap:describesOperationalPort, ap:servesTradeLocation, ap:areaOfPort, ap:terminalOfPort))
      FILTER NOT EXISTS { ?assertion a ap:MatchAssertion; ap:subject $this; ap:relation ?path;
        ap:object ?value; ap:reviewStatus ap:Accepted; ap:evidence ?evidence . }
    }
  """ ] ;
    sh:targetSubjectsOf ports:areaOfPort,
        ports:describesOperationalPort,
        ports:servesTradeLocation,
        ports:terminalOfPort .

<https://projekt-provider.de/ontology/shapes/ports#NoGlobalIdentityShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 0 ;
            sh:path owl:sameAs ],
        [ sh:maxCount 0 ;
            sh:path owl:equivalentClass ],
        [ sh:maxCount 0 ;
            sh:path owl:equivalentProperty ] ;
    sh:targetSubjectsOf owl:equivalentClass,
        owl:equivalentProperty,
        owl:sameAs .

<https://projekt-provider.de/ontology/shapes/ports#PortPilotScopeShape> a sh:NodeShape ;
    sh:sparql [ sh:message "No AP2 port-pilot target found; empty or unrelated graphs are not validated by this baseline." ;
            sh:select """
    PREFIX ap: <https://projekt-provider.de/ontology/ports#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT $this WHERE { FILTER NOT EXISTS { ?node a/rdfs:subClassOf* ?role .
      FILTER(?role IN (ap:SourcePortFeature, ap:TradeLocation, ap:SourceRecord, ap:OperationalPort, ap:Observation, ap:MatchAssertion)) } }
  """ ] ;
    sh:targetNode <urn:provider:ap2:validation-scope> .

<https://projekt-provider.de/ontology/shapes/ports#RoleIdentifierShape> a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https?://[^ ]+$" ;
    sh:targetClass ports:OperationalPort,
        ports:PortArea,
        ports:SourcePortFeature,
        ports:SourceRecord,
        ports:Terminal,
        ports:TradeLocation .

