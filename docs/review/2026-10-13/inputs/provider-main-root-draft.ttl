@prefix :        <http://projekt-provider.de/ontology/> .
@prefix bfo:     <http://purl.obolibrary.org/obo/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix gist:    <https://w3id.org/semanticarts/ns/ontology/gist/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .


# ============================================================================
# ONTOLOGY DECLARATION
# ============================================================================

<http://projekt-provider.de/ontology/> a owl:Ontology ;
    owl:imports <https://w3id.org/semanticarts/ontology/gistBFO> ;
    rdfs:label "PROVIDER Core Ontology"@en ;
    rdfs:comment """
        Core ontology for modelling cross-sector supply chains, disruptions,
        monitoring signals, impacts, and mitigation actions. Infrastructure
        assets from OSM-derived modules can later be aligned as subclasses of
        Facility, InfrastructureAsset, Route, or Network.
    """@en ;
    dcterms:created "2026-05-26"^^xsd:date ;
    owl:versionInfo "0.1.0" .


# ============================================================================
# UPPER-LEVEL CORE CLASSES
# ============================================================================

:Sector a owl:Class ;
    rdfs:subClassOf bfo:BFO_0000141 ;
    rdfs:label "Sector"@en ;
    rdfs:comment "A socially constructed immaterial entity aggregating actors, infrastructure, and recurrent processes that collectively realize a characteristic economic, industrial, administrative, or societal function."@en .

:Region a owl:Class ;
    rdfs:label "Region"@en ;
    rdfs:comment "A geographic area relevant to production, logistics, trade, regulation, or impact assessment."@en .

:Actor a owl:Class ;
    rdfs:label "Actor"@en ;
    rdfs:comment "An agent or organization that participates in, governs, monitors, or is affected by a supply chain."@en .

:Organization a owl:Class ;
    rdfs:subClassOf :Actor ;
    rdfs:label "Organization"@en ;
    rdfs:comment "A formally or informally organized actor such as a company, public authority, cooperative, or association."@en .

:Facility a owl:Class ;
    rdfs:label "Facility"@en ;
    rdfs:comment "A site or installation where supply-chain activities occur, such as production, storage, processing, transfer, inspection, or sale."@en .

:InfrastructureAsset a owl:Class ;
    rdfs:subClassOf :Facility ;
    rdfs:label "Infrastructure asset"@en ;
    rdfs:comment "A physical facility or network element used to enable transport, storage, energy, communication, or other operational functions."@en ;
    skos:scopeNote "OSM-derived infrastructure classes should align here or to more specific subclasses in an infrastructure module."@en .

:Product a owl:Class ;
    rdfs:label "Product"@en ;
    rdfs:comment "A material or immaterial thing produced, transformed, traded, consumed, or otherwise handled in a supply chain."@en .

:Commodity a owl:Class ;
    rdfs:subClassOf :Product ;
    rdfs:label "Commodity"@en ;
    rdfs:comment "A traded product that is largely interchangeable within a market category, such as soybeans, soymeal, crude oil, grain, or electricity."@en .

:Process a owl:Class ;
    rdfs:label "Process"@en ;
    rdfs:comment "An activity or process that changes, moves, stores, monitors, governs, or consumes products and resources."@en .

:SupplyChain a owl:Class ;
    rdfs:label "Supply chain"@en ;
    rdfs:comment "A system of actors, facilities, flows, and processes through which products are produced, transformed, transported, distributed, and consumed."@en .

:SupplyChainStage a owl:Class ;
    rdfs:label "Supply chain stage"@en ;
    rdfs:comment "A coherent step or phase within a supply chain, such as farming, storage, inland transport, export handling, ocean transport, import handling, processing, distribution, or consumption."@en .

:Flow a owl:Class ;
    rdfs:label "Flow"@en ;
    rdfs:comment "A movement, transfer, or exchange of products, information, value, or responsibility between actors, facilities, stages, or regions."@en .

:Route a owl:Class ;
    rdfs:label "Route"@en ;
    rdfs:comment "A planned or observed path along which a flow moves."@en ;
    skos:scopeNote "OSM route relations and network routes can later be aligned to this class."@en .

:Network a owl:Class ;
    rdfs:label "Network"@en ;
    rdfs:comment "A connected system of route, segment, node, or facility elements that enables movement, communication, energy distribution, or other connectivity."@en ;
    skos:scopeNote "OSM-derived road, railway, waterway, power, pipeline, and telecom network abstractions can later specialize this class."@en .


# ============================================================================
# SECTOR SPECIALIZATIONS
# ============================================================================

:AgriculturalSector a owl:Class ;
    rdfs:subClassOf :Sector ;
    rdfs:label "Agricultural sector"@en ;
    rdfs:comment "A sector that realizes the cultivation of plants, the raising of animals, or related production activities directed toward the provision of agricultural products."@en .

:LogisticsSector a owl:Class ;
    rdfs:subClassOf :Sector ;
    rdfs:label "Logistics sector"@en ;
    rdfs:comment "A sector covering the transportation, storage, coordination, and distribution of goods, materials, or resources."@en .

:TradeSector a owl:Class ;
    rdfs:subClassOf :Sector ;
    rdfs:label "Trade sector"@en ;
    rdfs:comment "A sector that realizes the exchange, distribution, purchase, or sale of goods or services."@en .

:ProcessingSector a owl:Class ;
    rdfs:subClassOf :Sector ;
    rdfs:label "Processing sector"@en ;
    rdfs:comment "A sector that transforms products or materials into derived products, intermediate goods, or consumer goods."@en .

:EnergySector a owl:Class ;
    rdfs:subClassOf :Sector ;
    rdfs:label "Energy sector"@en ;
    rdfs:comment "A sector concerned with the production, conversion, distribution, storage, trade, or consumption of energy."@en .

:PublicSector a owl:Class ;
    rdfs:subClassOf :Sector ;
    rdfs:label "Public sector"@en ;
    rdfs:comment "A sector comprising public authorities and institutions involved in regulation, intervention, public services, or governance."@en .


# ============================================================================
# ACTOR AND FACILITY SPECIALIZATIONS
# ============================================================================

:Producer a owl:Class ;
    rdfs:subClassOf :Organization ;
    rdfs:label "Producer"@en ;
    rdfs:comment "An organization that produces or cultivates a product."@en .

:Trader a owl:Class ;
    rdfs:subClassOf :Organization ;
    rdfs:label "Trader"@en ;
    rdfs:comment "An organization that buys, sells, brokers, or coordinates commodity exchange."@en .

:Carrier a owl:Class ;
    rdfs:subClassOf :Organization ;
    rdfs:label "Carrier"@en ;
    rdfs:comment "An organization responsible for transporting products or resources."@en .

:Processor a owl:Class ;
    rdfs:subClassOf :Organization ;
    rdfs:label "Processor"@en ;
    rdfs:comment "An organization that transforms an input product into one or more output products."@en .

:Regulator a owl:Class ;
    rdfs:subClassOf :Organization ;
    rdfs:label "Regulator"@en ;
    rdfs:comment "An organization with authority to define, enforce, or monitor rules affecting actors, products, markets, or flows."@en .

:Retailer a owl:Class ;
    rdfs:subClassOf :Organization ;
    rdfs:label "Retailer"@en ;
    rdfs:comment "An organization that sells products to final or near-final consumers."@en .

:Farm a owl:Class ;
    rdfs:subClassOf :Facility ;
    rdfs:label "Farm"@en ;
    rdfs:comment "A facility or site used for agricultural production."@en .

:StorageFacility a owl:Class ;
    rdfs:subClassOf :Facility ;
    rdfs:label "Storage facility"@en ;
    rdfs:comment "A facility used to store products, materials, or resources."@en .

:ProcessingFacility a owl:Class ;
    rdfs:subClassOf :Facility ;
    rdfs:label "Processing facility"@en ;
    rdfs:comment "A facility where products or materials are transformed into other products or intermediate goods."@en .

:TransferFacility a owl:Class ;
    rdfs:subClassOf :InfrastructureAsset ;
    rdfs:label "Transfer facility"@en ;
    rdfs:comment "An infrastructure asset where products or passengers are transferred between vehicles, modes, routes, organizations, or jurisdictions."@en .


# ============================================================================
# RISK, EVENT, SIGNAL, AND IMPACT CLASSES
# ============================================================================

:Risk a owl:Class ;
    rdfs:label "Risk"@en ;
    rdfs:comment "A possible adverse condition involving uncertainty, exposure, vulnerability, likelihood, and consequence."@en .

:Event a owl:Class ;
    rdfs:label "Event"@en ;
    rdfs:comment "Something that happens at a time or over a period and may affect actors, facilities, products, flows, sectors, or regions."@en .

:DisruptionEvent a owl:Class ;
    rdfs:subClassOf :Event ;
    rdfs:label "Disruption event"@en ;
    rdfs:comment "An event that degrades, interrupts, delays, reroutes, restricts, or otherwise negatively changes normal supply-chain behavior."@en .

:WeatherEvent a owl:Class ;
    rdfs:subClassOf :DisruptionEvent ;
    rdfs:label "Weather event"@en ;
    rdfs:comment "A disruption event caused by weather or climate conditions."@en .

:BiologicalEvent a owl:Class ;
    rdfs:subClassOf :DisruptionEvent ;
    rdfs:label "Biological event"@en ;
    rdfs:comment "A disruption event caused by pests, diseases, invasive species, or other biological pressures."@en .

:PolicyEvent a owl:Class ;
    rdfs:subClassOf :DisruptionEvent ;
    rdfs:label "Policy event"@en ;
    rdfs:comment "A disruption event caused by a policy, regulatory, trade, customs, or administrative decision."@en .

:LogisticsEvent a owl:Class ;
    rdfs:subClassOf :DisruptionEvent ;
    rdfs:label "Logistics event"@en ;
    rdfs:comment "A disruption event affecting transport, storage, handling, transfer capacity, scheduling, or routing."@en .

:MarketEvent a owl:Class ;
    rdfs:subClassOf :DisruptionEvent ;
    rdfs:label "Market event"@en ;
    rdfs:comment "A disruption event affecting price, liquidity, demand, supply, freight rates, or contract availability."@en .

:Impact a owl:Class ;
    rdfs:label "Impact"@en ;
    rdfs:comment "An observed, inferred, or expected consequence for an actor, sector, product, region, facility, process, or flow."@en .

:MitigationAction a owl:Class ;
    rdfs:label "Mitigation action"@en ;
    rdfs:comment "An action intended to reduce risk, exposure, vulnerability, disruption likelihood, or adverse impact."@en .

:DataSource a owl:Class ;
    rdfs:label "Data source"@en ;
    rdfs:comment "A source from which observations, indicators, forecasts, or signals are obtained."@en .

:Indicator a owl:Class ;
    rdfs:label "Indicator"@en ;
    rdfs:comment "A measurable variable or derived metric used to monitor state, performance, exposure, vulnerability, risk, or impact."@en .

:Observation a owl:Class ;
    rdfs:label "Observation"@en ;
    rdfs:comment "A measurement, estimate, report, forecast, or qualitative assessment of an indicator for a subject at a time or period."@en .

:MonitoringSignal a owl:Class ;
    rdfs:subClassOf :Observation ;
    rdfs:label "Monitoring signal"@en ;
    rdfs:comment "An observation or derived observation used to detect, anticipate, or explain a relevant change in the supply chain."@en .


# ============================================================================
# OBJECT PROPERTIES
# ============================================================================

:hasSector a owl:ObjectProperty ;
    rdfs:label "has sector"@en ;
    rdfs:comment "Links an actor, facility, process, supply chain, or event to a relevant sector."@en ;
    rdfs:range :Sector .

:locatedIn a owl:ObjectProperty ;
    rdfs:label "located in"@en ;
    rdfs:comment "Links an actor, facility, event, process, flow, or observation to a relevant region."@en ;
    rdfs:range :Region .

:operatesFacility a owl:ObjectProperty ;
    rdfs:label "operates facility"@en ;
    rdfs:comment "Links an actor to a facility it operates, manages, or controls."@en ;
    rdfs:domain :Actor ;
    rdfs:range :Facility .

:participatesIn a owl:ObjectProperty ;
    rdfs:label "participates in"@en ;
    rdfs:comment "Links an actor, facility, product, process, stage, or event to a supply chain or process in which it participates."@en .

:hasStage a owl:ObjectProperty ;
    rdfs:label "has stage"@en ;
    rdfs:comment "Links a supply chain to one of its stages."@en ;
    rdfs:domain :SupplyChain ;
    rdfs:range :SupplyChainStage .

:precedesStage a owl:ObjectProperty ;
    rdfs:label "precedes stage"@en ;
    rdfs:comment "Links a supply-chain stage to a later stage in the same supply chain."@en ;
    rdfs:domain :SupplyChainStage ;
    rdfs:range :SupplyChainStage .

:hasInput a owl:ObjectProperty ;
    rdfs:label "has input"@en ;
    rdfs:comment "Links a process or stage to a product, resource, signal, or other entity used as input."@en ;
    rdfs:range owl:Thing .

:hasOutput a owl:ObjectProperty ;
    rdfs:label "has output"@en ;
    rdfs:comment "Links a process or stage to a product, signal, impact, or other entity produced as output."@en ;
    rdfs:range owl:Thing .

:handlesProduct a owl:ObjectProperty ;
    rdfs:label "handles product"@en ;
    rdfs:comment "Links an actor, facility, process, stage, flow, or supply chain to a product it handles."@en ;
    rdfs:range :Product .

:movesAlong a owl:ObjectProperty ;
    rdfs:label "moves along"@en ;
    rdfs:comment "Links a flow to the route or network along which it moves."@en ;
    rdfs:domain :Flow ;
    rdfs:range [ owl:unionOf ( :Route :Network ) ] .

:originatesAt a owl:ObjectProperty ;
    rdfs:label "originates at"@en ;
    rdfs:comment "Links a flow, route, event, or process to its origin actor, facility, stage, or region."@en .

:terminatesAt a owl:ObjectProperty ;
    rdfs:label "terminates at"@en ;
    rdfs:comment "Links a flow, route, event, or process to its destination actor, facility, stage, or region."@en .

:dependsOn a owl:ObjectProperty ;
    rdfs:label "depends on"@en ;
    rdfs:comment "Links an entity to another entity whose availability, performance, state, or behavior it depends on."@en .

:affectedBy a owl:ObjectProperty ;
    rdfs:label "affected by"@en ;
    rdfs:comment "Links an entity to an event, risk, condition, or impact that affects it."@en .

:affects a owl:ObjectProperty ;
    rdfs:label "affects"@en ;
    rdfs:comment "Links an event, risk, condition, or impact to an entity it affects."@en ;
    owl:inverseOf :affectedBy .

:causes a owl:ObjectProperty ;
    rdfs:label "causes"@en ;
    rdfs:comment "Links an event, risk, observation, or impact to a resulting event, impact, condition, or state."@en .

:indicates a owl:ObjectProperty ;
    rdfs:label "indicates"@en ;
    rdfs:comment "Links an observation or monitoring signal to the risk, event, condition, impact, or entity state it indicates."@en .

:observesIndicator a owl:ObjectProperty ;
    rdfs:label "observes indicator"@en ;
    rdfs:comment "Links an observation to the indicator it measures, estimates, forecasts, or reports."@en ;
    rdfs:domain :Observation ;
    rdfs:range :Indicator .

:observedFor a owl:ObjectProperty ;
    rdfs:label "observed for"@en ;
    rdfs:comment "Links an observation to the actor, facility, product, flow, region, process, stage, sector, or event it describes."@en ;
    rdfs:domain :Observation .

:derivedFrom a owl:ObjectProperty ;
    rdfs:label "derived from"@en ;
    rdfs:comment "Links an observation, indicator, signal, or assessment to a source observation, data source, or method."@en .

:mitigates a owl:ObjectProperty ;
    rdfs:label "mitigates"@en ;
    rdfs:comment "Links a mitigation action to the risk, event, vulnerability, exposure, or impact it is intended to reduce."@en ;
    rdfs:domain :MitigationAction .

:implementedBy a owl:ObjectProperty ;
    rdfs:label "implemented by"@en ;
    rdfs:comment "Links a mitigation action, process, or intervention to the actor responsible for implementing it."@en ;
    rdfs:range :Actor .


# ============================================================================
# DATATYPE PROPERTIES
# ============================================================================

:identifier a owl:DatatypeProperty ;
    rdfs:label "identifier"@en ;
    rdfs:comment "A local, external, or domain-specific identifier."@en ;
    rdfs:range xsd:string .

:name a owl:DatatypeProperty ;
    rdfs:label "name"@en ;
    rdfs:comment "A human-readable name."@en ;
    rdfs:range xsd:string .

:description a owl:DatatypeProperty ;
    rdfs:label "description"@en ;
    rdfs:comment "A human-readable description."@en ;
    rdfs:range xsd:string .

:startTime a owl:DatatypeProperty ;
    rdfs:label "start time"@en ;
    rdfs:comment "The start date or timestamp of an event, process, observation, action, or validity interval."@en ;
    rdfs:range xsd:dateTime .

:endTime a owl:DatatypeProperty ;
    rdfs:label "end time"@en ;
    rdfs:comment "The end date or timestamp of an event, process, observation, action, or validity interval."@en ;
    rdfs:range xsd:dateTime .

:value a owl:DatatypeProperty ;
    rdfs:label "value"@en ;
    rdfs:comment "The literal value of an observation, indicator reading, parameter, or estimate."@en .

:unit a owl:DatatypeProperty ;
    rdfs:label "unit"@en ;
    rdfs:comment "The unit of measure associated with a value."@en ;
    rdfs:range xsd:string .

:confidence a owl:DatatypeProperty ;
    rdfs:label "confidence"@en ;
    rdfs:comment "A confidence score or qualitative confidence description associated with an observation, forecast, signal, risk, or assessment."@en .

:severity a owl:DatatypeProperty ;
    rdfs:label "severity"@en ;
    rdfs:comment "A severity score or qualitative severity description associated with a risk, event, impact, or signal."@en .

:probability a owl:DatatypeProperty ;
    rdfs:label "probability"@en ;
    rdfs:comment "A probability or likelihood value associated with a risk, event, impact, or forecast."@en ;
    rdfs:range xsd:decimal .

:sequenceIndex a owl:DatatypeProperty ;
    rdfs:label "sequence index"@en ;
    rdfs:comment "A non-negative integer indicating the order of a stage, flow, route element, or process step."@en ;
    rdfs:range xsd:nonNegativeInteger .


# ============================================================================
# ALIGNMENT PLACEHOLDERS FOR OSM-DERIVED INFRASTRUCTURE MODULES
# ============================================================================

:TransportInfrastructureAsset a owl:Class ;
    rdfs:subClassOf :InfrastructureAsset ;
    rdfs:label "Transport infrastructure asset"@en ;
    rdfs:comment "An infrastructure asset that enables movement of people, products, vehicles, or vessels."@en ;
    skos:scopeNote "OSM road, railway, port, airport, waterway, and route classes can later align below this class."@en .

:StorageInfrastructureAsset a owl:Class ;
    rdfs:subClassOf :InfrastructureAsset ;
    rdfs:label "Storage infrastructure asset"@en ;
    rdfs:comment "An infrastructure asset that stores products, materials, resources, or vehicles."@en .

:EnergyInfrastructureAsset a owl:Class ;
    rdfs:subClassOf :InfrastructureAsset ;
    rdfs:label "Energy infrastructure asset"@en ;
    rdfs:comment "An infrastructure asset that generates, stores, converts, transmits, or distributes energy."@en .

:CommunicationInfrastructureAsset a owl:Class ;
    rdfs:subClassOf :InfrastructureAsset ;
    rdfs:label "Communication infrastructure asset"@en ;
    rdfs:comment "An infrastructure asset that enables telecommunications, sensing, or data transmission."@en .

