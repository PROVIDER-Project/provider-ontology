@prefix ports: <https://projekt-provider.de/ontology/ports#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix provider: <https://projekt-provider.de/ontology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://projekt-provider.de/ontology/shapes/ports#EpisodeShape> a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:not [ sh:class ports:Event ] ;
    sh:property [ sh:class ports:Event ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ports:episodeOf ] ;
    sh:targetClass ports:EventEpisode .

<https://projekt-provider.de/ontology/shapes/ports#EventRepresentationShape> a sh:NodeShape ;
    sh:class <https://provider-project.org/ontology/pdl#Event> ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:class provider:Event ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ports:representsEvent ],
        [ sh:in ( ports:Real ports:Synthetic ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ports:dataKind ] ;
    sh:targetSubjectsOf ports:representsEvent .

<https://projekt-provider.de/ontology/shapes/ports#FacilityRepresentationShape> a sh:NodeShape ;
    sh:class <https://provider-project.org/ontology/pdl#Infrastructure> ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:class provider:Facility ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ports:representsFacility ],
        [ sh:in ( ports:Real ports:Synthetic ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ports:dataKind ] ;
    sh:targetSubjectsOf ports:representsFacility .

<https://projekt-provider.de/ontology/shapes/ports#MeasurementShape> a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:in ( ports:DailyPortCalls ports:ImportShipmentEstimate ports:ExportShipmentEstimate ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ports:metric ],
        [ sh:in ( ports:PortCallCount ports:MetricTonne ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ports:unit ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path ports:value ] ;
    sh:sparql [ sh:message "Metric/unit mismatch or fractional daily port calls." ;
            sh:select """
    PREFIX ap: <https://projekt-provider.de/ontology/ports#>
    SELECT $this WHERE { $this ap:metric ?metric; ap:unit ?unit; ap:value ?value .
      FILTER((?metric = ap:DailyPortCalls && (?unit != ap:PortCallCount || ?value != FLOOR(?value)))
       || (?metric IN (ap:ImportShipmentEstimate, ap:ExportShipmentEstimate) && ?unit != ap:MetricTonne)) }
  """ ] ;
    sh:targetClass ports:Measurement .

<https://projekt-provider.de/ontology/shapes/ports#ObservationActivityShape> a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:not [ sh:class ports:Observation ] ;
    sh:property [ sh:class ports:Observation ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sosa:hasResult ],
        [ sh:class ports:OperationalPort ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sosa:hasFeatureOfInterest ] ;
    sh:sparql [ sh:message "Activity, result and provenance must reference the same feature and one another." ;
            sh:select """
    PREFIX ap: <https://projekt-provider.de/ontology/ports#>
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    PREFIX prov: <http://www.w3.org/ns/prov#>
    SELECT $this WHERE { $this sosa:hasResult ?result; sosa:hasFeatureOfInterest ?feature .
      FILTER NOT EXISTS { ?result ap:observedFeature ?feature; prov:wasGeneratedBy $this . } }
  """ ] ;
    sh:targetClass ports:ObservationActivity .

<https://projekt-provider.de/ontology/shapes/ports#ObservationResultShape> a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:not [ sh:class sosa:Observation ] ;
    sh:pattern "^https?://[^ ]+$" ;
    sh:property [ sh:class ports:OperationalPort ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ports:observedFeature ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ports:observedDay ;
            sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" ],
        [ sh:class ports:SourceObservation ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ports:sourceObservation ],
        [ sh:class ports:Measurement ;
            sh:minCount 1 ;
            sh:path ports:hasMeasurement ],
        [ sh:class ports:ObservationActivity ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:in ( ports:Real ports:Synthetic ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ports:dataKind ],
        [ sh:maxCount 0 ;
            sh:path sosa:hasFeatureOfInterest ] ;
    sh:targetClass ports:Observation .

<https://projekt-provider.de/ontology/shapes/ports#ObservationSourceBindingShape> a sh:NodeShape ;
    sh:sparql [ sh:message "Observation source day/feature must agree with the canonical result and an accepted port association." ;
            sh:select """
    PREFIX ap: <https://projekt-provider.de/ontology/ports#>
    PREFIX pw: <https://portwatch.imf.org/ontology/>
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    SELECT $this WHERE { $this ap:sourceObservation ?source; ap:observedDay ?day; ap:observedFeature ?port .
      FILTER NOT EXISTS { ?source pw:observationDate ?day; sosa:hasFeatureOfInterest ?feature .
        ?feature ap:describesOperationalPort ?port .
        ?match a ap:MatchAssertion; ap:subject ?feature; ap:relation ap:describesOperationalPort;
               ap:object ?port; ap:reviewStatus ap:Accepted . } }
  """ ],
        [ sh:message "Canonical measurement must preserve the selected source value for its metric." ;
            sh:select """
    PREFIX ap: <https://projekt-provider.de/ontology/ports#>
    PREFIX pw: <https://portwatch.imf.org/ontology/>
    SELECT $this WHERE { $this ap:sourceObservation ?source; ap:hasMeasurement ?measurement .
      ?measurement ap:metric ?metric; ap:value ?value .
      FILTER((?metric = ap:DailyPortCalls && !EXISTS { ?source pw:portCallsTotal ?sourceValue . FILTER(?sourceValue = ?value) })
        || (?metric = ap:ImportShipmentEstimate && !EXISTS { ?source pw:importVolumeTotalTons ?sourceValue . FILTER(?sourceValue = ?value) })
        || (?metric = ap:ExportShipmentEstimate && !EXISTS { ?source pw:exportVolumeTotalTons ?sourceValue . FILTER(?sourceValue = ?value) })) }
  """ ] ;
    sh:targetClass ports:Observation .

<https://projekt-provider.de/ontology/shapes/ports#OperationalPortShape> a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https?://[^ ]+$" ;
    sh:property [ sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ports:countryISO2 ;
            sh:pattern "^[A-Z]{2}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ports:countryISO3 ;
            sh:pattern "^[A-Z]{3}$" ],
        [ sh:in ( ports:Real ports:Synthetic ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ports:dataKind ] ;
    sh:sparql [ sh:message "Conflicting pilot ISO2/ISO3 pair (BR/BRA or DE/DEU)." ;
            sh:select """
    PREFIX ap: <https://projekt-provider.de/ontology/ports#>
    SELECT $this WHERE { $this ap:countryISO2 ?two; ap:countryISO3 ?three .
      FILTER((?two = "BR" && ?three != "BRA") || (?two = "DE" && ?three != "DEU")) }
  """ ] ;
    sh:targetClass ports:OperationalPort .

