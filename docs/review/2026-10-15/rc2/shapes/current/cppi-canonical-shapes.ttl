@prefix ports: <https://projekt-provider.de/ontology/ports#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://projekt-provider.de/ontology/cppi#ActivityShape> a sh:NodeShape ;
    sh:property [ sh:class ports:OperationalPort ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sosa:hasFeatureOfInterest ],
        [ sh:class <https://projekt-provider.de/ontology/cppi#AnnualObservation> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sosa:hasResult ] ;
    sh:sparql [ sh:message "Activity feature must equal result feature." ;
            sh:select """
 PREFIX cp: <https://projekt-provider.de/ontology/cppi#>
 PREFIX sosa: <http://www.w3.org/ns/sosa/>
 SELECT $this WHERE { $this sosa:hasResult ?o; sosa:hasFeatureOfInterest ?p . FILTER NOT EXISTS { ?o cp:observedFeature ?p . } }
 """ ] ;
    sh:targetClass <https://projekt-provider.de/ontology/cppi#ObservationActivity> .

<https://projekt-provider.de/ontology/cppi#AlignmentShape> a sh:NodeShape ;
    sh:property [ sh:class <https://projekt-provider.de/ontology/source/cppi#ContainerPort> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://projekt-provider.de/ontology/cppi#sourcePort> ],
        [ sh:class ports:OperationalPort ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://projekt-provider.de/ontology/cppi#canonicalPort> ],
        [ sh:hasValue ports:Accepted ;
            sh:maxCount 1 ;
            sh:path ports:reviewStatus ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path <https://projekt-provider.de/ontology/cppi#reviewer> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path <https://projekt-provider.de/ontology/cppi#evidenceNote> ] ;
    sh:targetClass <https://projekt-provider.de/ontology/cppi#PortAlignment> .

<https://projekt-provider.de/ontology/cppi#AnnualShape> a sh:NodeShape ;
    sh:property [ sh:class ports:OperationalPort ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://projekt-provider.de/ontology/cppi#observedFeature> ],
        [ sh:datatype xsd:gYear ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://projekt-provider.de/ontology/cppi#referenceYear> ],
        [ sh:class <https://projekt-provider.de/ontology/source/cppi#ContainerPortPerformanceObservation> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://projekt-provider.de/ontology/cppi#sourceObservation> ],
        [ sh:class <https://projekt-provider.de/ontology/cppi#Measurement> ;
            sh:minCount 1 ;
            sh:path <https://projekt-provider.de/ontology/cppi#hasMeasurement> ],
        [ sh:class <https://projekt-provider.de/ontology/cppi#PortAlignment> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://projekt-provider.de/ontology/cppi#alignment> ],
        [ sh:class <https://projekt-provider.de/ontology/cppi#ObservationActivity> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:in ( ports:Real ports:Synthetic ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ports:dataKind ] ;
    sh:sparql [ sh:message "Annual source year, feature and explicitly accepted alignment must agree." ;
            sh:select """
 PREFIX cp: <https://projekt-provider.de/ontology/cppi#>
 PREFIX ap: <https://projekt-provider.de/ontology/ports#>
 PREFIX src: <https://projekt-provider.de/ontology/source/cppi#>
 SELECT $this WHERE {
  $this cp:referenceYear ?y; cp:observedFeature ?p; cp:sourceObservation ?s; cp:alignment ?a .
  FILTER NOT EXISTS { ?s src:referenceYear ?y; src:forPort ?sp . ?a cp:sourcePort ?sp; cp:canonicalPort ?p; ap:reviewStatus ap:Accepted . }
 }""" ] ;
    sh:targetClass <https://projekt-provider.de/ontology/cppi#AnnualObservation> .

<https://projekt-provider.de/ontology/cppi#MeasurementShape> a sh:NodeShape ;
    sh:property [ sh:in ( <https://projekt-provider.de/ontology/cppi#CPPIIndexScore> <https://projekt-provider.de/ontology/cppi#GlobalRank> <https://projekt-provider.de/ontology/cppi#AdministrativeIndexScore> <https://projekt-provider.de/ontology/cppi#StatisticalIndexScore> <https://projekt-provider.de/ontology/cppi#SamplePortCalls> <https://projekt-provider.de/ontology/cppi#BerthTimeShare> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://projekt-provider.de/ontology/cppi#metric> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://projekt-provider.de/ontology/cppi#unit> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://projekt-provider.de/ontology/cppi#value> ] ;
    sh:sparql [ sh:message "Measurement value and unit must match the source predicate and metric." ;
            sh:select """
 PREFIX cp: <https://projekt-provider.de/ontology/cppi#>
 SELECT $this WHERE {
  $this cp:metric ?m; cp:value ?v; cp:unit ?u .
  FILTER NOT EXISTS { ?m cp:sourcePredicate ?pred; cp:unit ?u . ?o cp:hasMeasurement $this; cp:sourceObservation ?s . ?s ?pred ?sourceValue . FILTER(?v = ?sourceValue) }
 }""" ],
        [ sh:message "Rank/count must be integral and valid, and berth fraction must lie in [0,1]." ;
            sh:select """
 PREFIX cp: <https://projekt-provider.de/ontology/cppi#>
 PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
 SELECT $this WHERE {
 $this cp:metric ?m; cp:value ?v .
 FILTER((?m=cp:GlobalRank && (?v<1 || ?v != xsd:integer(?v))) || (?m=cp:SamplePortCalls && (?v<0 || ?v != xsd:integer(?v))) || (?m=cp:BerthTimeShare && (?v<0 || ?v>1)))
 }""" ] ;
    sh:targetClass <https://projekt-provider.de/ontology/cppi#Measurement> .

