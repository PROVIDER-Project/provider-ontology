@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://projekt-provider.de/ontology/source/cppi#CPPIEditionShape> a sh:NodeShape ;
    sh:property [ sh:minCount 1 ;
            sh:path dct:title ],
        [ sh:datatype xsd:gYear ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://projekt-provider.de/ontology/source/cppi#editionYear> ],
        [ sh:datatype xsd:gYear ;
            sh:maxCount 1 ;
            sh:path <https://projekt-provider.de/ontology/source/cppi#referenceDistributionYear> ] ;
    sh:targetClass <https://projekt-provider.de/ontology/source/cppi#ContainerPortPerformanceIndexEdition> .

<https://projekt-provider.de/ontology/source/cppi#CPPIObservationShape> a sh:NodeShape ;
    sh:closed false ;
    sh:or ( [ sh:property [ sh:datatype xsd:decimal ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:path <https://projekt-provider.de/ontology/source/cppi#cppiScore> ] ] [ sh:property [ sh:datatype xsd:integer ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:minInclusive 1 ;
                        sh:path <https://projekt-provider.de/ontology/source/cppi#globalRank> ] ] ) ;
    sh:property [ sh:class <https://projekt-provider.de/ontology/source/cppi#Port> ;
            sh:maxCount 1 ;
            sh:message "A CPPI observation must identify exactly one port."@en ;
            sh:minCount 1 ;
            sh:path <https://projekt-provider.de/ontology/source/cppi#forPort> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path <https://projekt-provider.de/ontology/source/cppi#cppiScore> ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:path <https://projekt-provider.de/ontology/source/cppi#globalRank> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path <https://projekt-provider.de/ontology/source/cppi#administrativeScore> ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:path <https://projekt-provider.de/ontology/source/cppi#administrativeRank> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path <https://projekt-provider.de/ontology/source/cppi#statisticalScore> ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:path <https://projekt-provider.de/ontology/source/cppi#statisticalRank> ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:maxCount 1 ;
            sh:path <https://projekt-provider.de/ontology/source/cppi#numberOfPortCalls> ],
        [ sh:datatype xsd:positiveInteger ;
            sh:maxCount 1 ;
            sh:path <https://projekt-provider.de/ontology/source/cppi#sourceRowNumber> ],
        [ sh:class <https://projekt-provider.de/ontology/source/cppi#ContainerPortPerformanceIndexEdition> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://projekt-provider.de/ontology/source/cppi#inCPPIEdition> ],
        [ sh:datatype xsd:gYear ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://projekt-provider.de/ontology/source/cppi#referenceYear> ;
            sh:pattern "^20[0-9]{2}$" ] ;
    sh:targetClass <https://projekt-provider.de/ontology/source/cppi#ContainerPortPerformanceObservation> .

<https://projekt-provider.de/ontology/source/cppi#CPPIPortShape> a sh:NodeShape ;
    sh:property [ sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:flags "i" ;
            sh:maxCount 1 ;
            sh:path <https://projekt-provider.de/ontology/source/cppi#unLocode> ;
            sh:pattern "^[A-Z]{2}[A-Z0-9]{3}$" ] ;
    sh:targetClass <https://projekt-provider.de/ontology/source/cppi#ContainerPort> .

