@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shape: <http://projekt-provider.de/shapes/ap2#> .
@prefix ap: <http://projekt-provider.de/ontology/ap2-pilot#> .
@prefix pw: <https://portwatch.imf.org/ontology/> .
@prefix src: <https://projekt-provider.de/ontology/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# Source roles stay source roles; no domain/range inference or canonical reminting.
shape:SourcePortShape a sh:NodeShape ; sh:targetClass pw:Port ;
  sh:nodeKind sh:IRI ; sh:pattern "^https?://[^ ]+$" ;
  sh:property [ sh:path pw:portName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path pw:unlocode ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[A-Z]{2} ?[A-Z0-9]{3}$" ] ;
  sh:property [ sh:path pw:locatedInCountry ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path (pw:locatedInCountry pw:iso3) ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[A-Z]{3}$" ] .

shape:TradeLocationShape a sh:NodeShape ; sh:targetClass src:TradeLocation ;
  sh:nodeKind sh:IRI ; sh:pattern "^https?://[^ ]+$" ;
  sh:property [ sh:path dct:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[A-Z]{2}[A-Z0-9]{3}$" ] ;
  sh:property [ sh:path src:countryCode ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[A-Z]{2}$" ] ;
  sh:sparql [ sh:message "UN/LOCODE identifier and country code disagree." ; sh:select """
    PREFIX dct: <http://purl.org/dc/terms/>
    PREFIX src: <https://projekt-provider.de/ontology/>
    SELECT $this WHERE { $this dct:identifier ?code; src:countryCode ?country .
      FILTER(SUBSTR(STR(?code),1,2) != STR(?country)) }
  """ ] .

shape:SourceRecordShape a sh:NodeShape ; sh:targetClass ap:SourceRecord ;
  sh:nodeKind sh:IRI ; sh:pattern "^https?://[^ ]+$" ;
  sh:property [ sh:path dct:isPartOf ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path ap:sourceRowHash ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] ;
  sh:property [ sh:path src:sourceRow ; sh:maxCount 1 ; sh:datatype rdf:JSON ] ;
  sh:or ( [ sh:property [ sh:path ap:sourceRowHash ; sh:minCount 1 ] ]
          [ sh:property [ sh:path src:sourceRow ; sh:minCount 1 ] ] ) .

shape:PortTrafficShape a sh:NodeShape ; sh:targetClass pw:PortTrafficObservation ;
  sh:nodeKind sh:IRI ; sh:pattern "^https?://[^ ]+$" ;
  sh:property [ sh:path pw:observedPort ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pw:Port ] ;
  sh:property [ sh:path sosa:hasFeatureOfInterest ; sh:minCount 1 ; sh:maxCount 1 ; sh:equals pw:observedPort ] ;
  sh:property [ sh:path pw:observationDate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ; sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" ] ;
  sh:property [ sh:path pw:portCallsTotal ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
  sh:property [ sh:path pw:importVolumeTotalTons ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] ;
  sh:property [ sh:path pw:exportVolumeTotalTons ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] .

shape:GeometryLinkShape a sh:NodeShape ; sh:targetSubjectsOf geo:hasGeometry ;
  sh:property [ sh:path geo:hasGeometry ; sh:nodeKind sh:IRI ; sh:class geo:Geometry ] .
shape:GeometryShape a sh:NodeShape ; sh:targetSubjectsOf geo:asWKT ;
  sh:nodeKind sh:IRI ;
  sh:property [ sh:path geo:asWKT ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype geo:wktLiteral ; sh:minLength 1 ] .

# This pilot validates unqualified CRS84 POINTs. Polygon topology/CRS transforms
# are explicitly not claimed; other geometry families remain source-specific.
shape:PointBoundsShape a sh:NodeShape ; sh:targetSubjectsOf geo:asWKT ;
  sh:sparql [ sh:message "POINT must have exactly two finite CRS84 coordinates within longitude/latitude bounds." ; sh:select """
    PREFIX geo: <http://www.opengis.net/ont/geosparql#>
    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
    SELECT $this WHERE {
      $this geo:asWKT ?wkt . FILTER(STRSTARTS(UCASE(STR(?wkt)), "POINT"))
      BIND(REPLACE(STR(?wkt), "^[Pp][Oo][Ii][Nn][Tt] *[(](.*)[)]$", "$1") AS ?coords)
      BIND(xsd:double(STRBEFORE(?coords, " ")) AS ?lon)
      BIND(xsd:double(STRAFTER(?coords, " ")) AS ?lat)
      FILTER(!REGEX(STR(?wkt), "^[Pp][Oo][Ii][Nn][Tt] *[(][-+]?[0-9]+([.][0-9]+)?([eE][-+]?[0-9]+)? [-+]?[0-9]+([.][0-9]+)?([eE][-+]?[0-9]+)?[)]$")
        || !BOUND(?lon) || !BOUND(?lat) || ?lon < -180 || ?lon > 180 || ?lat < -90 || ?lat > 90)
    }
  """ ] .
