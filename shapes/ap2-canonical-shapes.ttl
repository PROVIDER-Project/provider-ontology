@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shape: <http://projekt-provider.de/shapes/ap2#> .
@prefix ap: <http://projekt-provider.de/ontology/ap2-pilot#> .
@prefix core: <http://projekt-provider.de/ontology/> .
@prefix pdl: <https://provider-project.org/ontology/pdl#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shape:OperationalPortShape a sh:NodeShape ; sh:targetClass ap:OperationalPort ;
  sh:nodeKind sh:IRI ; sh:pattern "^https?://[^ ]+$" ;
  sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:minLength 1 ] ;
  sh:property [ sh:path ap:countryISO2 ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[A-Z]{2}$" ] ;
  sh:property [ sh:path ap:countryISO3 ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[A-Z]{3}$" ] ;
  sh:property [ sh:path ap:dataKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in (ap:Real ap:Synthetic) ] ;
  sh:sparql [ sh:message "Conflicting pilot ISO2/ISO3 pair (BR/BRA or DE/DEU)." ; sh:select """
    PREFIX ap: <http://projekt-provider.de/ontology/ap2-pilot#>
    SELECT $this WHERE { $this ap:countryISO2 ?two; ap:countryISO3 ?three .
      FILTER((?two = "BR" && ?three != "BRA") || (?two = "DE" && ?three != "DEU")) }
  """ ] .

shape:ObservationResultShape a sh:NodeShape ; sh:targetClass ap:Observation ;
  sh:nodeKind sh:IRI ; sh:pattern "^https?://[^ ]+$" ;
  sh:not [ sh:class sosa:Observation ] ;
  sh:property [ sh:path sosa:hasFeatureOfInterest ; sh:maxCount 0 ] ;
  sh:property [ sh:path ap:observedFeature ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ap:OperationalPort ] ;
  sh:property [ sh:path ap:observedDay ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ; sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" ] ;
  sh:property [ sh:path ap:sourceObservation ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ap:SourceObservation ] ;
  sh:property [ sh:path ap:hasMeasurement ; sh:minCount 1 ; sh:class ap:Measurement ] ;
  sh:property [ sh:path prov:wasGeneratedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ap:ObservationActivity ] ;
  sh:property [ sh:path ap:dataKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in (ap:Real ap:Synthetic) ] .

shape:ObservationActivityShape a sh:NodeShape ; sh:targetClass ap:ObservationActivity ;
  sh:nodeKind sh:IRI ; sh:not [ sh:class ap:Observation ] ;
  sh:property [ sh:path sosa:hasResult ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ap:Observation ] ;
  sh:property [ sh:path sosa:hasFeatureOfInterest ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ap:OperationalPort ] ;
  sh:sparql [ sh:message "Activity, result and provenance must reference the same feature and one another." ; sh:select """
    PREFIX ap: <http://projekt-provider.de/ontology/ap2-pilot#>
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    PREFIX prov: <http://www.w3.org/ns/prov#>
    SELECT $this WHERE { $this sosa:hasResult ?result; sosa:hasFeatureOfInterest ?feature .
      FILTER NOT EXISTS { ?result ap:observedFeature ?feature; prov:wasGeneratedBy $this . } }
  """ ] .

shape:MeasurementShape a sh:NodeShape ; sh:targetClass ap:Measurement ;
  sh:nodeKind sh:IRI ;
  sh:property [ sh:path ap:metric ; sh:minCount 1 ; sh:maxCount 1 ; sh:in (ap:DailyPortCalls ap:ImportShipmentEstimate ap:ExportShipmentEstimate) ] ;
  sh:property [ sh:path ap:unit ; sh:minCount 1 ; sh:maxCount 1 ; sh:in (ap:PortCallCount ap:MetricTonne) ] ;
  sh:property [ sh:path ap:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] ;
  sh:sparql [ sh:message "Metric/unit mismatch or fractional daily port calls." ; sh:select """
    PREFIX ap: <http://projekt-provider.de/ontology/ap2-pilot#>
    SELECT $this WHERE { $this ap:metric ?metric; ap:unit ?unit; ap:value ?value .
      FILTER((?metric = ap:DailyPortCalls && (?unit != ap:PortCallCount || ?value != FLOOR(?value)))
       || (?metric IN (ap:ImportShipmentEstimate, ap:ExportShipmentEstimate) && ?unit != ap:MetricTonne)) }
  """ ] .

shape:EpisodeShape a sh:NodeShape ; sh:targetClass ap:EventEpisode ;
  sh:nodeKind sh:IRI ; sh:not [ sh:class ap:Event ] ;
  sh:property [ sh:path ap:episodeOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ap:Event ] .
shape:FacilityRepresentationShape a sh:NodeShape ; sh:targetSubjectsOf ap:representsFacility ;
  sh:class pdl:Infrastructure ; sh:nodeKind sh:IRI ;
  sh:property [ sh:path ap:representsFacility ; sh:minCount 1 ; sh:maxCount 1 ; sh:class core:Facility ] ;
  sh:property [ sh:path ap:dataKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in (ap:Real ap:Synthetic) ] .
shape:EventRepresentationShape a sh:NodeShape ; sh:targetSubjectsOf ap:representsEvent ;
  sh:class pdl:Event ; sh:nodeKind sh:IRI ;
  sh:property [ sh:path ap:representsEvent ; sh:minCount 1 ; sh:maxCount 1 ; sh:class core:Event ] ;
  sh:property [ sh:path ap:dataKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in (ap:Real ap:Synthetic) ] .

shape:ObservationSourceBindingShape a sh:NodeShape ; sh:targetClass ap:Observation ;
  sh:sparql [ sh:message "Observation source day/feature must agree with the canonical result and an accepted port association." ; sh:select """
    PREFIX ap: <http://projekt-provider.de/ontology/ap2-pilot#>
    PREFIX pw: <https://portwatch.imf.org/ontology/>
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    SELECT $this WHERE { $this ap:sourceObservation ?source; ap:observedDay ?day; ap:observedFeature ?port .
      FILTER NOT EXISTS { ?source pw:observationDate ?day; sosa:hasFeatureOfInterest ?feature .
        ?feature ap:describesOperationalPort ?port .
        ?match a ap:MatchAssertion; ap:subject ?feature; ap:relation ap:describesOperationalPort;
               ap:object ?port; ap:reviewStatus ap:Accepted . } }
  """ ] ;
  sh:sparql [ sh:message "Canonical measurement must preserve the selected source value for its metric." ; sh:select """
    PREFIX ap: <http://projekt-provider.de/ontology/ap2-pilot#>
    PREFIX pw: <https://portwatch.imf.org/ontology/>
    SELECT $this WHERE { $this ap:sourceObservation ?source; ap:hasMeasurement ?measurement .
      ?measurement ap:metric ?metric; ap:value ?value .
      FILTER((?metric = ap:DailyPortCalls && !EXISTS { ?source pw:portCallsTotal ?sourceValue . FILTER(?sourceValue = ?value) })
        || (?metric = ap:ImportShipmentEstimate && !EXISTS { ?source pw:importVolumeTotalTons ?sourceValue . FILTER(?sourceValue = ?value) })
        || (?metric = ap:ExportShipmentEstimate && !EXISTS { ?source pw:exportVolumeTotalTons ?sourceValue . FILTER(?sourceValue = ?value) })) }
  """ ] .
